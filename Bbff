// COLLISION
// ============================================================
function collidesTilesOnly(x,y){
  const hbX = x+4, hbY = y+16, hbW = 16, hbH = 14;
  for(const [cx,cy] of [[hbX,hbY],[hbX+hbW-1,hbY],[hbX,hbY+hbH-1],[hbX+hbW-1,hbY+hbH-1]]){
    const t2 = tileAt(Math.floor(cx/TILE), Math.floor(cy/TILE));
    if(BLOCKING.has(t2)) return true;
  }
  return false;
}
function collides(x,y){
  const hbX = x+4, hbY = y+16, hbW = 16, hbH = 14;
  for(const [cx,cy] of [[hbX,hbY],[hbX+hbW-1,hbY],[hbX,hbY+hbH-1],[hbX+hbW-1,hbY+hbH-1]]){
    const t2 = tileAt(Math.floor(cx/TILE), Math.floor(cy/TILE));
    if(BLOCKING.has(t2)) return true;
  }
  const m = currentMap();
  if(m.objects) for(const o of m.objects){
    if(!o.solid) continue;
    let ox, oy, ow, oh;
    if(o.type==='tree' || o.type==='pine'){ ox = o.tx*TILE+2; oy = (o.ty+1)*TILE-18; ow = TILE-4; oh = 18; }
    else if(o.type==='rock_s'){ ox = o.tx*TILE+2; oy = (o.ty+1)*TILE-10; ow = TILE-4; oh = 10; }
    else if(o.type==='rock_m'){ ox = o.tx*TILE-2; oy = (o.ty+1)*TILE-11; ow = TILE+4; oh = 11; }
    else if(o.type==='rock_l'){ ox = o.tx*TILE-4; oy = (o.ty+1)*TILE-12; ow = TILE+8; oh = 12; }
    else if(o.type==='barrel' || o.type==='signpost'){ ox = o.tx*TILE+2; oy = (o.ty+1)*TILE-10; ow = TILE-4; oh = 10; }
    else if(o.type==='bed' || o.type==='bed_canopy'){ ox = o.tx*TILE; oy = o.ty*TILE+TILE; ow = TILE*2; oh = TILE*2; }
    else if(o.type==='table' || o.type==='desk_fancy' || o.type==='workbench'){ ox = o.tx*TILE; oy = o.ty*TILE+TILE/2; ow = TILE*2; oh = TILE*1.5; }
    else if(o.type==='chest' || o.type==='bookshelf' || o.type==='furnace' || o.type==='medicine_cabinet' || o.type==='fridge' || o.type==='kitchen_stove' || o.type==='armor_stand' || o.type==='easel' || o.type==='mine_cart' || o.type==='hay_bale'){ ox = o.tx*TILE; oy = o.ty*TILE; ow = TILE*2; oh = TILE*2; }
    else if(o.type==='crop' || o.type==='flower_r' || o.type==='flower_y' || o.type==='flower_b' || o.type==='flower_w'
         || o.type==='mushroom' || o.type==='bush' || o.type==='rock_small' || o.type==='wood_stump'
         || o.type==='bench' || o.type==='lamp_post' || o.type==='plant' || o.type==='portrait'
         || o.type==='books_pile' || o.type==='radio' || o.type==='television' || o.type==='picture_frame'
         || o.type==='flower_vase' || o.type==='potted_herbs' || o.type==='rug_oval' || o.type==='wood_stool'
         || o.type==='shelf_wall' || o.type==='wall_clock' || o.type==='plant_fern' || o.type==='lantern_hang'
         || o.type==='sculpture' || o.type==='trophy' || o.type==='specimen_jar' || o.type==='mirror'
         || o.type==='market_crate' || o.type==='milk_can' || o.type==='neon_sign' || o.type==='camera_tripod'
         || o.type==='chair' || o.type==='cauldron' || o.type==='telescope' || o.type==='cave_entrance') continue;
    else { ox = o.tx*TILE; oy = o.ty*TILE; ow = TILE*2; oh = TILE*2; }
    if(hbX<ox+ow && hbX+hbW>ox && hbY<oy+oh && hbY+hbH>oy) return true;
  }
  for(const n of NPC_DATA){
    if(n.loc!==Game.map) continue;
    if(hbX<n.x-8+16 && hbX+hbW>n.x-8 && hbY<n.y-16+16 && hbY+hbH>n.y-16) return true;
  }
  if(Game.map==='farm'){
    for(const a of World.farm.animals){
      if(Game.onHorse && a.mounted) continue;
      if(hbX<a.x-8+16 && hbX+hbW>a.x-8 && hbY<a.y-14+14 && hbY+hbH>a.y-14) return true;
    }
  }
  if(Game.map==='town' && World.town.buildings){
    for(const b of World.town.buildings){
      const bx = b.x*TILE+4, by = b.y*TILE+40, bw = b.w*TILE-8, bh = b.h*TILE-40;
      if(hbX<bx+bw && hbX+hbW>bx && hbY<by+bh && hbY+hbH>by){
        if(b.door){
          const dx = b.door.x*TILE+2, dw = TILE-4;
          if(hbX+hbW>dx && hbX<dx+dw && hbY+hbH>by+bh-TILE*1.5) return false;
        }
        return true;
      }
    }
  }
  if(Game.map==='farm'){
    const ha = World.farm.houseArea;
    const hL = ha.x*TILE+4, hT = ha.y*TILE+50, hW = ha.w*TILE-8, hH = ha.h*TILE-50;
    const dX = World.farm.houseDoor.x*TILE+2, dW = TILE-4;
    if(hbX<hL+hW && hbX+hbW>hL && hbY<hT+hH && hbY+hbH>hT){
      if(hbX+hbW>dX && hbX<dX+dW && hbY+hbH>hT+hH-TILE*1.5) return false;
      return true;
    }
    const sp = World.farm.shopPos;
    const sL = sp.x*TILE, sT = sp.y*TILE+40, sW = 6*TILE, sH = 6*TILE-40;
    const sd = World.farm.shopDoor;
    if(hbX<sL+sW && hbX+hbW>sL && hbY<sT+sH && hbY+hbH>sT){
      const dx = sd.x*TILE+2, dw = TILE-4;
      if(hbX+hbW>dx && hbX<dx+dw && hbY+hbH>sT+sH-TILE*1.5) return false;
      return true;
    }
    const st = World.farm.stablePos;
    if(hbX<st.x*TILE+112 && hbX+hbW>st.x*TILE && hbY<st.y*TILE+80 && hbY+hbH>st.y*TILE+30) return true;
    const cp = World.farm.carpenterPos;
    if(hbX<cp.x*TILE+128 && hbX+hbW>cp.x*TILE && hbY<cp.y*TILE+112 && hbY+hbH>cp.y*TILE+50) return true;
  }
  return false;
}

