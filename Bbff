function loadGame(){
  try{
    const raw = localStorage.getItem('pixelfarm_save');
    if(!raw) return false;
    const d = JSON.parse(raw);
    Game.time = d.time; Game.day = d.day; Game.season = d.season; Game.seasonDay = d.seasonDay;
    Game.weather = d.weather||'sunny';
    Game.nextWeather = d.nextWeather || pickWeather();
    Game.energy = d.energy; Game.hp = d.hp||100; Game.gold = d.gold;
    if(d.inv) Game.inv = Object.assign(Game.inv, d.inv);
    Game.weaponLevel = d.weaponLevel||0;
    Game.maxHp = d.maxHp || 100;
    if(d.toolLevels) Game.toolLevels = Object.assign(Game.toolLevels, d.toolLevels);
    Game.map = d.map||'farm'; Game.selected = d.selected||0;
    player.x = d.player.x; player.y = d.player.y; player.dir = d.player.dir||'d';
    if(d.farm && d.farm.tiles && d.farm.objects){
      World.farm.tiles = d.farm.tiles;
      World.farm.objects = d.farm.objects;
      World.farm.animals = d.farm.animals||[];
    }
    if(d.npcs) for(const sd of d.npcs){
      const n = NPC_DATA.find(x=>x.id===sd.id);
      if(n){
        n.hearts = sd.hearts||0; n.questDone = !!sd.questDone; n.questGiven = !!sd.questGiven;
        n.greetedToday = !!sd.greetedToday; n.lastTalkedDay = sd.lastTalkedDay||0;
        n.giftToday = !!sd.giftToday; n.giftWeek = sd.giftWeek||0; n.giftCount = sd.giftCount||0;
        n.metBefore = !!sd.metBefore;
        n.storiesSeen = sd.storiesSeen||[];
        n.questionsAsked = sd.questionsAsked||[];
      }
    }
    Game.activeQuests = d.activeQuests||[]; Game.completedQuests = d.completedQuests||0;
    Game.kills = d.kills||{}; Game.fishCaught = d.fishCaught||{};
    Game.museumDonations = d.museumDonations||{}; Game.achieved = d.achieved||[];
    Game.endingShown = !!d.endingShown;
    if(d.skills) Game.skills = Object.assign(Game.skills, d.skills);
    if(d.skillXp) Game.skillXp = Object.assign(Game.skillXp, d.skillXp);
    if(d.mineMaxFloor) Game.mineMaxFloor = d.mineMaxFloor;
    if(d.custom){ Object.assign(Custom, d.custom); Custom.save(); regenerateChar(); }
    Game.week = currentWeek();
    return true;
  }catch(e){ return false; }
}
