// MINE GENERATOR (fixed progression)
// ============================================================
function generateMine(depth){
  const m = World.mine;
  m.w = 40; m.h = 30;
  m.depth = depth;
  m.tiles = makeMap(40,30,T_ROCK);
  m.objects = [];

  const entranceRoom = {x:1, y:1, w:7, h:5};
  const exitRoom = {x:33, y:24, w:6, h:5};

  const rooms = [entranceRoom, exitRoom];
  const numRooms = 3 + Math.min(5, Math.floor(depth/4));
  for(let i=0;i<numRooms;i++){
    const rw = 4+Math.floor(Math.random()*5);
    const rh = 4+Math.floor(Math.random()*5);
    const rx = 4+Math.floor(Math.random()*(m.w-rw-6));
    const ry = 4+Math.floor(Math.random()*(m.h-rh-6));
    if(rx < entranceRoom.x+entranceRoom.w+2 && ry < entranceRoom.y+entranceRoom.h+2) continue;
    if(rx + rw > exitRoom.x-2 && ry + rh > exitRoom.y-2) continue;
    rooms.push({x:rx,y:ry,w:rw,h:rh});
  }

  for(const r of rooms){
    for(let y=r.y;y<r.y+r.h;y++) for(let x=r.x;x<r.x+r.w;x++){
      if(x>0 && y>0 && x<m.w-1 && y<m.h-1) m.tiles[y][x] = T_CAVE;
    }
  }

  for(let i=1;i<rooms.length;i++){
    const a = rooms[i-1], b = rooms[i];
    const ax = Math.floor(a.x+a.w/2), ay = Math.floor(a.y+a.h/2);
    const bx = Math.floor(b.x+b.w/2), by = Math.floor(b.y+b.h/2);
    for(let x=Math.min(ax,bx);x<=Math.max(ax,bx);x++) if(m.tiles[ay][x]===T_ROCK) m.tiles[ay][x] = T_CAVE;
    for(let y=Math.min(ay,by);y<=Math.max(ay,by);y++) if(m.tiles[y][bx]===T_ROCK) m.tiles[y][bx] = T_CAVE;
  }

  m.stairsUp = {x:entranceRoom.x+1, y:entranceRoom.y+1};
  m.ladder = {x:exitRoom.x+Math.floor(exitRoom.w/2), y:exitRoom.y+Math.floor(exitRoom.h/2)};
  m.elevator = (depth % 5 === 0) ? {x:entranceRoom.x+entranceRoom.w-2, y:entranceRoom.y+1} : null;

  for(let y=0;y<m.h;y++) for(let x=0;x<m.w;x++){
    if(m.tiles[y][x] !== T_ROCK) continue;
    let adj = false;
    for(let dy=-1;dy<=1;dy++) for(let dx=-1;dx<=1;dx++){
      const ny = y+dy, nx = x+dx;
      if(ny>=0 && ny<m.h && nx>=0 && nx<m.w && m.tiles[ny][nx] === T_CAVE){ adj = true; }
    }
    if(!adj) continue;
    if(Math.random()<0.15){
      let ore = T_CU;
      const r0 = Math.random();
      if(depth>=60 && r0<0.15) ore = T_IRID;
      else if(depth>=40 && r0<0.35) ore = T_GO;
      else if(depth>=20 && r0<0.5) ore = T_IR;
      m.tiles[y][x] = ore;
    }
  }

  Game.monsters = [];
  const avail = MONSTER_TYPES.filter((t2,i)=>{
    if(i===0) return true;
    if(i===1&&depth>5) return true;
    if(i===2&&depth>15) return true;
    if(i===3&&depth>25) return true;
    if(i===4&&depth>40) return true;
    return false;
  });
  const safeRooms = rooms.filter(r=>r !== entranceRoom);
  const count = Math.min(15, 3 + Math.floor(depth/2));
  for(let i=0;i<count;i++){
    if(!safeRooms.length) break;
    const r = safeRooms[Math.floor(Math.random()*safeRooms.length)];
    const ty = avail[Math.floor(Math.random()*avail.length)];
    const mm = { typeId:ty.id, name:ty.name, sprite:ty.sprite,
      x:(r.x+1+Math.random()*(r.w-2))*TILE+8,
      y:(r.y+1+Math.random()*(r.h-2))*TILE+16,
      hp:ty.hp, maxHp:ty.hp, dmg:ty.dmg,
      dir:1, frame:0, frameTimer:0, hitTimer:0, moveTimer:1500,
      wanderTarget:{x:0,y:0} };
    mm.wanderTarget = {x:mm.x, y:mm.y};
    Game.monsters.push(mm);
  }

  player.x = (entranceRoom.x+2)*TILE+8;
  player.y = (entranceRoom.y+2)*TILE+16;

  if(depth % 5 === 0 && depth > Game.mineMaxFloor) Game.mineMaxFloor = depth;
  toast('⛏ Mine — Floor ' + depth);
}

