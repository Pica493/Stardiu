  const lw = ctx.measureText(locNames[Game.map]||Game.map).width+16;
  ctx.fillRect(6,54,lw,16);
  ctx.strokeStyle = '#8a5a2a'; ctx.strokeRect(6.5,54.5,lw-1,15);
  ctx.fillStyle = '#e8c060'; ctx.fillText(locNames[Game.map]||Game.map, 10, 65);

  ctx.fillStyle = 'rgba(20,15,10,0.85)'; ctx.fillRect(6,74,80,16);
  ctx.strokeStyle = '#8a5a2a'; ctx.strokeRect(6.5,74.5,79,15);
  const wi = {sunny:'☀️ '+t('sunny'), rain:'🌧 '+t('rain'), storm:'⛈ '+t('storm'), snow:'❄️ '+t('snow'), fog:'🌫 '+t('fog')}[Game.weather];
  const nwi = {sunny:'☀️', rain:'🌧', storm:'⛈', snow:'❄️', fog:'🌫'}[Game.nextWeather||'sunny'];
  ctx.fillStyle = '#e8c060'; ctx.fillText(wi+' → '+nwi, 10, 85);

  // Skill mini-indicators (bottom-left)
  const skillMini = [['🌾',Game.skills.farming],['⛏',Game.skills.mining],['🎣',Game.skills.fishing]];
  ctx.fillStyle = 'rgba(20,15,10,0.85)'; ctx.fillRect(6,LH-46,90,18);
  ctx.strokeStyle = '#8a5a2a'; ctx.strokeRect(6.5,LH-45.5,89,17);
  ctx.fillStyle = '#e8c060'; ctx.font = 'bold 9px monospace';
  ctx.fillText(skillMini.map(s=>s[0]+s[1]).join(' '), 10, LH-33);

  // Right side info
  ctx.fillStyle = 'rgba(20,15,10,0.85)'; ctx.fillRect(LW-124,6,118,16);
  ctx.strokeStyle = '#8a5a2a'; ctx.strokeRect(LW-123.5,6.5,117,15);
  const hP = Game.hp/Game.maxHp;
  ctx.fillStyle = '#3a1010'; ctx.fillRect(LW-121,9,112,10);
  ctx.fillStyle = '#d04040'; ctx.fillRect(LW-121,9,112*hP,10);
  ctx.fillStyle = '#fff'; ctx.font = 'bold 9px monospace';
  ctx.fillText('❤ '+Math.round(Game.hp), LW-117, 18);

  ctx.fillStyle = 'rgba(20,15,10,0.85)'; ctx.fillRect(LW-124,26,118,16);
  ctx.strokeStyle = '#8a5a2a'; ctx.strokeRect(LW-123.5,26.5,117,15);
  const eP = Game.energy/Game.maxEnergy;
  ctx.fillStyle = '#3a2a10'; ctx.fillRect(LW-121,29,112,10);
  ctx.fillStyle = eP>0.5 ? '#6ac04a' : eP>0.25 ? '#e0c040' : '#c04040';
  ctx.fillRect(LW-121,29,112*eP,10);
  ctx.fillStyle = '#fff'; ctx.fillText('⚡ '+Math.round(Game.energy), LW-117, 38);

  ctx.fillStyle = 'rgba(20,15,10,0.85)'; ctx.fillRect(LW-124,46,118,16);
  ctx.strokeStyle = '#8a5a2a'; ctx.strokeRect(LW-123.5,46.5,117,15);
  ctx.fillStyle = '#e8c060'; ctx.fillText('⚔ '+WEAPONS[Game.weaponLevel].name, LW-121, 57);

  // HUD BUTTONS (draw with distinct look so they seem clickable)
  const btns = getHUDButtons();
  for(const b of btns){
    ctx.fillStyle = 'rgba(60,40,20,0.9)';
    ctx.fillRect(b.x, b.y, b.w, b.h);
    ctx.strokeStyle = '#c8a060'; ctx.strokeRect(b.x+0.5, b.y+0.5, b.w-1, b.h-1);
    ctx.fillStyle = '#ffe8b0'; ctx.font = 'bold 9px monospace';
    const label = {inv:'📦',craft:'⚒',map:'🗺',menu:'☰',pause:'⏸'}[b.id];
    ctx.fillText(label, b.x+12, b.y+12);
  }

  const hbW = 7*24+4;
  const hbX = (LW-hbW)/2;
  const hbY = LH-32;
  ctx.fillStyle = 'rgba(20,15,10,0.9)'; ctx.fillRect(hbX, hbY, hbW, 28);
  ctx.strokeStyle = '#8a5a2a'; ctx.lineWidth = 2;
  ctx.strokeRect(hbX+1, hbY+1, hbW-2, 26); ctx.lineWidth = 1;
  for(let i=0;i<7;i++){
    const x = hbX+2+i*24, y = hbY+2;
    ctx.fillStyle = i===Game.selected ? 'rgba(232,192,96,0.35)' : 'rgba(0,0,0,0.4)';
    ctx.fillRect(x, y, 20, 20);
    if(i===Game.selected){ ctx.strokeStyle = '#e8c060'; ctx.lineWidth = 2; ctx.strokeRect(x,y,20,20); ctx.lineWidth = 1; }
    if(S['i_'+Game.hotbar[i]]) ctx.drawImage(S['i_'+Game.hotbar[i]], x+2, y+2);
    ctx.fillStyle = 'rgba(255,255,255,0.6)'; ctx.font = 'bold 7px monospace';
    ctx.fillText(String(i+1), x+1, y+8);
  }
  ctx.font = 'bold 9px monospace';
  const tn = toolName(Game.hotbar[Game.selected])+' ('+TOOL_LEVELS[Game.toolLevels[Game.hotbar[Game.selected]]||0].name+')';
  const tw = ctx.measureText(tn).width+12;
  ctx.fillStyle = 'rgba(20,15,10,0.85)'; ctx.fillRect(hbX, hbY-14, tw, 12);
  ctx.strokeStyle = '#8a5a2a'; ctx.strokeRect(hbX+0.5, hbY-13.5, tw-1, 11);
  ctx.fillStyle = '#e8c060'; ctx.fillText(tn, hbX+6, hbY-5);

  if(Game.toastTimer>0){
    const alpha = Math.min(1, Game.toastTimer/300);
    ctx.font = 'bold 11px monospace';
    const tw2 = ctx.measureText(Game.toast).width+22;
    ctx.fillStyle = 'rgba(20,15,10,'+(0.9*alpha)+')';
    ctx.fillRect((LW-tw2)/2, 60, tw2, 18);
    ctx.strokeStyle = 'rgba(138,90,42,'+alpha+')';
    ctx.strokeRect((LW-tw2)/2+0.5, 60.5, tw2-1, 17);
    ctx.fillStyle = 'rgba(232,192,96,'+alpha+')';
    ctx.textAlign = 'center';
    ctx.fillText(Game.toast, LW/2, 73);
    ctx.textAlign = 'left';
  }
}

