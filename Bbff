function pickWeather(){
  const w = Math.random();
  if(Game.season===3 && w<0.35) return 'snow';
  if(w<0.25) return 'rain';
  if(w<0.32) return 'storm';
  if(w<0.42) return 'fog';
  return 'sunny';
}
function advanceDay(slept){
  Game.day++; Game.seasonDay++;
  if(Game.seasonDay>7){ Game.seasonDay = 1; Game.season = (Game.season+1)%4; toast(t(SEASONS[Game.season])); }
  Game.time = 6*60;
  Game.energy = slept ? Game.maxEnergy : Math.floor(Game.maxEnergy*0.6);
  Game.hp = Game.maxHp;
  Game.weather = Game.nextWeather || 'sunny';
  Game.nextWeather = pickWeather();
  for(const o of World.farm.objects){
    if(o.type==='crop'){
      if(o.watered && o.stage<4) o.stage++;
      o.watered = false;
      if(Game.weather==='rain') o.watered = true;
    }
  }
  const tiles = World.farm.tiles;
  for(let y=0;y<tiles.length;y++) for(let x=0;x<tiles[0].length;x++){
    if(tiles[y][x]===T_TILL_WET) tiles[y][x] = T_TILL;
    if(Game.weather==='rain' && tiles[y][x]===T_TILL) tiles[y][x] = T_TILL_WET;
  }
  for(const a of World.farm.animals){
    if(Math.random()<0.75) a.produceReady = true;
    if(a.growthStage<1){ a.growTimer = (a.growTimer||0)+1; if(a.growTimer>=3) a.growthStage = 1; }
  }
  decayFriendship();
  Game.week = currentWeek();
  Game.fishing = null; player.action = null;
  Game.map = 'farmhouse';
  player.x = 3*TILE; player.y = 7*TILE;
  player.targetX = null; player.targetY = null; player.actionTarget = null;
  Game.sleeping = false;
}

