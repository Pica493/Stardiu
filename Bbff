function renderLangSelect(){
  const g = $('langGrid'); if(!g) return;
  g.innerHTML = '';
  const langs = [{code:'en',name:'English',flag:'🇬🇧'},{code:'ru',name:'Русский',flag:'🇷🇺'}];
  for(const l of langs){
    const btn = document.createElement('button');
    btn.className = 'lang-btn';
    btn.innerHTML = '<span style="font-size:24px">'+l.flag+'</span><span>'+l.name+'</span>';
    btn.onclick = ()=>{
      localStorage.setItem('pixelfarm_lang', l.code);
      LANG = l.code;
      Snd.init(); Snd.resume(); Snd.play('click');
      applyLanguage();
      showMainMenu();
    };
    g.appendChild(btn);
  }
}
function applyLanguage(){
  if($('btnNew')) $('btnNew').textContent = t('newGame');
  if($('btnContinue')) $('btnContinue').textContent = t('cont');
  if($('btnHelp')) $('btnHelp').textContent = t('controls');
  if($('helpBody')) $('helpBody').innerHTML = t('helpText');
  if($('btnHelpBack')) $('btnHelpBack').textContent = t('back');
  const tabs = document.querySelectorAll('.tab-btn');
  if(tabs.length>=9){
    tabs[0].textContent = t('inventory').toUpperCase();
    tabs[1].textContent = t('craft').toUpperCase();
    tabs[2].textContent = t('quests').toUpperCase();
    tabs[3].textContent = t('museum').toUpperCase();
    tabs[4].textContent = t('skills').toUpperCase();
    tabs[5].textContent = t('social').toUpperCase();
    tabs[6].textContent = t('map').toUpperCase();
    tabs[7].textContent = t('character').toUpperCase();
    tabs[8].textContent = t('options').toUpperCase();
  }
  if($('btnMenuResume')) $('btnMenuResume').textContent = t('resume');
  if($('btnMenuSave')) $('btnMenuSave').textContent = t('save');
  if($('btnMenuMain')) $('btnMenuMain').textContent = t('mainMenu');
}
function showScreen(id){
  ['langSelect','menuMain','menuHelp','endingScreen','loadingScreen'].forEach(sid=>{
    const el = $(sid); if(!el) return;
    if(sid === id) el.classList.remove('hidden');
    else el.classList.add('hidden');
  });
}
function showMainMenu(){
  $('btnContinue').style.display = hasSave() ? 'block' : 'none';
  showScreen('menuMain');
  applyLanguage();
  Game.paused = true;
  Game.menuOpen = false;
  $('gameMenu').classList.remove('show');
  Snd.stopAll();
}

$('btnNew').addEventListener('click', ()=>{ Snd.init(); Snd.resume(); Snd.play('click'); newGame(); });
$('btnContinue').addEventListener('click', ()=>{
  Snd.init(); Snd.resume();
  if(loadGame()){
    Snd.play('click');
    showScreen(null);
    Game.paused = false;
    if(Snd.enabled) Snd.startMusic();
  } else toast('No save');
});
$('btnHelp').addEventListener('click', ()=>{ Snd.play('click'); showScreen('menuHelp'); });
$('btnHelpBack').addEventListener('click', ()=>{ Snd.play('click'); showScreen('menuMain'); });

function startInit(){
  try{
    regenerateChar();
    populateWorld();
    Snd.init();
  }catch(e){
    const el = $('loadText'); if(el) el.textContent = 'Error: '+e.message;
    console.error(e); return;
  }
  const bar = $('loadBar'), pct = $('loadPct'), txt = $('loadText');
  let p = 0;
  const tick = ()=>{
    p += 20 + Math.random()*30;
    if(p > 100) p = 100;
    bar.style.width = p+'%';
    pct.textContent = Math.round(p)+'%';
    if(p < 100) setTimeout(tick, 60);
    else {
      txt.textContent = 'Ready!';
      setTimeout(()=>{
        const ls = $('loadingScreen'); if(ls) ls.classList.add('hidden');
        if(!localStorage.getItem('pixelfarm_lang')){
          showScreen('langSelect');
          Game.paused = true;
        } else {
          showMainMenu();
        }
        lastTime = performance.now();
        requestAnimationFrame(loop);
      }, 300);
    }
  };
  tick();
}

renderLangSelect();
setTimeout(startInit, 50);
</script>
