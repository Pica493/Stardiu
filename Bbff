function craftItem(recipe){
  if(recipe.station && !hasStation(recipe.station)){
    Snd.play('error'); toast('Need workstation: '+recipe.station); return;
  }
  for(const k in recipe.need){
    if((Game.inv[k]||0) < recipe.need[k]){ Snd.play('error'); toast('Not enough '+k); return; }
  }
  for(const k in recipe.need) Game.inv[k] -= recipe.need[k];
  recipe.result();
  Snd.play('levelup');
  toast(t('crafted')+': '+recipe.name);
  renderMenuTab('craft');
}
function donateToMuseum(item){
  if(Game.museumDonations[item.id]) return;
  if((Game.inv[item.id]||0) <= 0){ Snd.play('error'); toast('You have 0 '+item.name); return; }
  Game.inv[item.id]--;
  Game.museumDonations[item.id] = true;
  Snd.play('donate');
  toast('Donated: '+item.name);
  addAchieve('museum_'+item.id, 'Museum: '+item.name);
  const count = Object.keys(Game.museumDonations).length;
  if(count === MUSEUM_ITEMS.length && !Game.endingShown){ setTimeout(showEnding, 800); }
}
function showEnding(){
  Game.endingShown = true;
  Snd.play('levelup'); Snd.stopMusic();
  $('endingStats').innerHTML =
    '🏆 Museum: '+Object.keys(Game.museumDonations).length+'/'+MUSEUM_ITEMS.length+'<br>'+
