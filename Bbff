const CROPS = ['wheat','carrot','tomato','potato','corn','pumpkin'];
function drawCrop(g,type,stage){
  const cx=8;
  if(stage===0){ rr(g,cx-1,14,2,2,'#5a3a1a'); rr(g,cx,13,1,1,'#4a8a2a'); return; }
  if(stage===1){ rr(g,cx-1,12,2,4,'#4a8a2a'); rr(g,cx-3,10,2,2,'#5aa04a'); return; }
  if(stage===2){ rr(g,cx-1,10,2,6,'#4a8a2a'); rr(g,cx-3,7,2,3,'#5aa04a'); return; }
  if(stage===3){ rr(g,cx-1,6,2,10,'#4a8a2a'); rr(g,cx-4,4,3,3,'#5aa04a'); return; }
  if(type==='wheat'){ rr(g,cx-1,2,2,14,'#c8a840'); rr(g,cx-3,4,2,3,'#e0c050'); }
  else if(type==='carrot'){ rr(g,cx-3,10,3,6,'#e07020'); rr(g,cx,10,3,6,'#e07020'); }
  else if(type==='tomato'){ rr(g,cx-4,9,4,5,'#d03030'); rr(g,cx,9,4,5,'#d03030'); }
  else if(type==='potato'){ rr(g,cx-4,10,4,5,'#a87848'); rr(g,cx,10,4,5,'#a87848'); }
  else if(type==='corn'){ rr(g,cx-1,2,2,14,'#4a8a2a'); rr(g,cx-4,4,3,6,'#c8a840'); }
  else { rr(g,cx-5,9,10,7,'#e08020'); }
}
for(const t2 of CROPS) for(let s=0;s<5;s++) spr('crop_'+t2+'_'+s,16,16,g=>drawCrop(g,t2,s));

