const S = {};
function spr(n,w,h,fn){ try{ const c = document.createElement('canvas'); c.width=w; c.height=h; const g = c.getContext('2d'); g.imageSmoothingEnabled = false; fn(g,w,h); S[n]=c; }catch(e){} }
function rr(g,x,y,w,h,c){ g.fillStyle=c; g.fillRect(x|0,y|0,w|0,h|0); }
function mirror(a,b){ const s=S[a]; if(!s) return; const c = document.createElement('canvas'); c.width=s.width; c.height=s.height; const g = c.getContext('2d'); g.imageSmoothingEnabled = false; g.translate(s.width,0); g.scale(-1,1); g.drawImage(s,0,0); S[b]=c; }

