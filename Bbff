addEventListener('keydown', e=>{
  const k = e.key.toLowerCase();
  keys[k] = true;
  if(['arrowup','arrowdown','arrowleft','arrowright',' '].includes(k)) e.preventDefault();
  if(Game.dialogue){ if(k==='escape'||k===' '||k==='enter'){ advanceDialogue(); } return; }
  if($('elevatorMenu').classList.contains('show')){ if(k==='escape') closeElevator(); return; }
  if(Game.menuOpen){ if(k==='escape') closeMenu(); return; }
  if(Game.sleeping) return;
  if(k==='escape'){ openMenu(); return; }
  if(k==='i'){ openMenu('inventory'); return; }
  if(k==='c'){ openMenu('craft'); return; }
  if(k==='m'){ openMenu('map'); return; }
  if(k==='h'){ toggleHorse(); return; }
  if(k>='1'&&k<='7'){ Game.selected = parseInt(k)-1; Snd.play('click'); }
});
addEventListener('keyup', e=>{ keys[e.key.toLowerCase()] = false; });

function screenToWorld(cx,cy){
  const rect = cv.getBoundingClientRect();
  const sx = (cx-rect.left) * (cv.width/rect.width) / SCALE;
  const sy = (cy-rect.top) * (cv.height/rect.height) / SCALE;
  return {x:sx+camera.x, y:sy+camera.y};
}
let pointerDown = false, pointerStartX = 0, pointerStartY = 0, pointerMoved = false;

// HUD button bounding boxes (in low-res coords)
function getHUDButtons(){
  const hbY = LH-32;
  return [
    {id:'inv',  x:LW-124, y:64, w:38, h:16, action:()=>openMenu('inventory')},
    {id:'craft',x:LW-84,  y:64, w:38, h:16, action:()=>openMenu('craft')},
    {id:'map',  x:LW-44,  y:64, w:38, h:16, action:()=>openMenu('map')},
    {id:'menu', x:LW-124, y:84, w:38, h:16, action:()=>openMenu()},
    {id:'pause',x:LW-84,  y:84, w:38, h:16, action:()=>openMenu()},
  ];
}
function getHotbarRect(){ const hbW = 7*24+4; return {x:(LW-hbW)/2, y:LH-32, w:hbW, h:28}; }

cv.addEventListener('pointerdown', e=>{
  if(Game.dialogue || Game.menuOpen || Game.sleeping) return;
  e.preventDefault();
  const rect = cv.getBoundingClientRect();
  const lx = (e.clientX-rect.left) * (cv.width/rect.width) / SCALE;
  const ly = (e.clientY-rect.top) * (cv.height/rect.height) / SCALE;

  // HUD buttons — clickable
  for(const b of getHUDButtons()){
    if(lx>=b.x && lx<=b.x+b.w && ly>=b.y && ly<=b.y+b.h){
      Snd.play('click'); b.action(); return;
    }
  }
  // Hotbar
  const hbr = getHotbarRect();
  if(ly>hbr.y && ly<hbr.y+hbr.h && lx>hbr.x && lx<hbr.x+hbr.w){
    const idx = Math.floor((lx-hbr.x-2)/24);
    if(idx>=0 && idx<Game.hotbar.length){ Game.selected = idx; Snd.play('click'); }
    return;
  }
  // Ignore other HUD zones (top-left panels, right-side panels)
  if(lx < 130 && ly < 115) return;
  if(lx > LW-130 && ly < 64) return;

  pointerDown = true; pointerMoved = false;
  pointerStartX = e.clientX; pointerStartY = e.clientY;
  const p = screenToWorld(e.clientX, e.clientY);
  const tx = Math.floor(p.x/TILE), ty = Math.floor(p.y/TILE);
  player.actionTarget = {tx, ty, obj:findObjectAt(tx,ty), npc:findNPCAt(tx,ty), monster:findMonsterAt(tx,ty)};
  player.targetX = p.x; player.targetY = p.y;
});
cv.addEventListener('pointermove', e=>{
  if(!pointerDown || Game.menuOpen || Game.sleeping || Game.dialogue) return;
  if(Math.hypot(e.clientX-pointerStartX, e.clientY-pointerStartY)>12) pointerMoved = true;
  if(pointerMoved){
    const p = screenToWorld(e.clientX, e.clientY);
    player.targetX = p.x; player.targetY = p.y;
    const tx = Math.floor(p.x/TILE), ty = Math.floor(p.y/TILE);
    player.actionTarget = {tx, ty, obj:findObjectAt(tx,ty), npc:findNPCAt(tx,ty), monster:findMonsterAt(tx,ty)};
  }
});
addEventListener('pointerup', ()=>{ pointerDown = false; });
addEventListener('pointercancel', ()=>{ pointerDown = false; });

