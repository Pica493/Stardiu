// UPDATE
// ============================================================
let lastTime = performance.now();
let waterFrame = 0, waterTimer = 0;

function update(dt){
  if(Game.paused || Game.menuOpen || Game.sleeping || Game.dialogue || $('elevatorMenu').classList.contains('show')) return;

  // Water animation
  waterTimer += dt; if(waterTimer > 300){ waterTimer = 0; waterFrame = (waterFrame+1)%4; }

  Game.time += dt*0.001*(1200/(20*60));
  if(Game.time>=26*60){ Game.time = 26*60; forceSleep(); }
  if(Game.toastTimer>0) Game.toastTimer -= dt;
  if(player.action){ player.actionTimer -= dt; if(player.actionTimer<=0) player.action = null; }
  if(player.invuln>0) player.invuln -= dt;

  if(Game.fishing){
    Game.fishing.timer += dt;
    if(Game.fishing.timer>Game.fishing.duration && !Game.fishing.caught){
      Game.fishing.caught = true;
      const f = getFishingResult();
      if(Math.random() < f.chance+0.2){
        Game.fishCaught[f.name] = (Game.fishCaught[f.name]||0)+1;
        Game.inv.fish = (Game.inv.fish||0)+1;
        Snd.play('fish'); toast('🐟 '+f.name+' ('+f.price+'🪙)');
        addSkill('fishing', 5);
      } else { Snd.play('error'); toast('Nothing...'); }
    }
    if(Game.fishing.timer>Game.fishing.duration+800) Game.fishing = null;
    return;
  }

  // Keyboard input
  let dx = 0, dy = 0;
  if(keys['w']||keys['arrowup']){ dy = -1; player.dir = 'u'; }
  if(keys['s']||keys['arrowdown']){ dy = 1; player.dir = 'd'; }
  if(keys['a']||keys['arrowleft']){ dx = -1; player.dir = 'l'; }
  if(keys['d']||keys['arrowright']){ dx = 1; player.dir = 'r'; }
  if(dx!==0||dy!==0){ player.targetX = null; player.targetY = null; player.actionTarget = null; }

  // Click-to-move
  if(dx===0 && dy===0 && player.targetX!==null){
    const fx = player.x+12, fy = player.y+24;
    const tdx = player.targetX-fx, tdy = player.targetY-fy;
    const dist = Math.sqrt(tdx*tdx+tdy*tdy);
    if(dist<6){
      player.targetX = null; player.targetY = null;
      if(player.actionTarget){
        const atx = player.actionTarget.tx, aty = player.actionTarget.ty;
        const ddx = atx*TILE+TILE/2-fx, ddy = aty*TILE+TILE/2-fy;
        if(Math.abs(ddx)>Math.abs(ddy)) player.dir = ddx>0?'r':'l';
        else player.dir = ddy>0?'d':'u';
        if(Math.abs(ddx)<TILE*2 && Math.abs(ddy)<TILE*2){ doActionAt(atx, aty); }
        player.actionTarget = null;
      }
    } else {
      dx = tdx/dist; dy = tdy/dist;
      if(Math.abs(tdx)>Math.abs(tdy)) player.dir = tdx>0?'r':'l';
      else player.dir = tdy>0?'d':'u';
    }
  }
  if(dx!==0 && dy!==0){ dx *= 0.7071; dy *= 0.7071; }

  const moving = (dx!==0 || dy!==0);
  const speed = Game.onHorse ? player.speed*2.5 : player.speed;
  const nx = player.x + dx*speed;
  const ny = player.y + dy*speed;
  let blockedX = false, blockedY = false;
  if(!collides(nx, player.y)) player.x = nx; else blockedX = true;
  if(!collides(player.x, ny)) player.y = ny; else blockedY = true;
  if(moving && blockedX && blockedY){
    player.stuckTimer = (player.stuckTimer||0) + dt;
    if(player.stuckTimer>1500){ player.targetX = null; player.targetY = null; player.actionTarget = null; player.stuckTimer = 0; }
  } else player.stuckTimer = 0;

  if(Game.onHorse){
    const horse = World.farm.animals.find(a=>a.type==='horse'&&a.mounted);
    if(horse){ horse.x = player.x+8; horse.y = player.y+24; }
  }

  if(moving){
    player.walkTimer += dt;
    const ft = Game.onHorse ? 90 : 140;
    while(player.walkTimer>ft){
      player.walkTimer -= ft;
      const old = player.walkPhase;
      player.walkPhase = (player.walkPhase+1) % 4;
      if((old===0||old===2) && (player.walkPhase===1||player.walkPhase===3)) Snd.play('step');
    }
  } else { player.walkPhase = 0; player.walkTimer = 0; }

  const targetCamX = player.x+12-LW/2;
  const targetCamY = player.y+24-LH/2;
  camera.x += (targetCamX-camera.x) * Math.min(1, dt*0.02);
  camera.y += (targetCamY-camera.y) * Math.min(1, dt*0.02);
  const m = currentMap();
  camera.x = Math.max(0, Math.min(camera.x, Math.max(0, m.w*TILE-LW)));
  camera.y = Math.max(0, Math.min(camera.y, Math.max(0, m.h*TILE-LH)));

  if(Game.particles.length > 60) Game.particles.length = 60;
  for(let i=Game.particles.length-1;i>=0;i--){
    const p = Game.particles[i];
    p.x += p.vx; p.y += p.vy; p.vy += 0.15; p.life -= dt;
    if(p.life<=0) Game.particles.splice(i,1);
  }

  if(Game.map==='farm'){
    for(const a of World.farm.animals){
      if(a.mounted) continue;
      if(a.produceTimer>0){ a.produceTimer -= dt; if(a.produceTimer<=0){ a.produceReady = true; a.produceTimer = 0; } }
      a.moveTimer -= dt;
      if(a.moveTimer<=0){
        a.moveTimer = 2000+Math.random()*2500;
        const pa = World.farm.penArea;
        a.tx = (pa.x+1+Math.random()*(pa.w-2))*TILE;
        a.ty = (pa.y+1+Math.random()*(pa.h-2))*TILE+16;
      }
      const adx = a.tx-a.x, ady = a.ty-a.y;
      const ad = Math.sqrt(adx*adx+ady*ady);
      if(ad>2){ a.x += adx/ad*0.35; a.y += ady/ad*0.35; a.dir = adx>0?1:-1;
        a.frameTimer += dt; if(a.frameTimer>260){ a.frameTimer=0; a.frame = (a.frame+1)%2; } }
    }
  }

  for(const n of NPC_DATA){
    if(n.loc!==Game.map) continue;
    n.moveTimer -= dt;
    if(n.moveTimer<=0){
      n.moveTimer = 2500+Math.random()*3000;
      n.wanderTarget = {x:n.hx*TILE+8+(Math.random()-0.5)*40, y:n.hy*TILE+16+(Math.random()-0.5)*40};
    }
    const ndx = n.wanderTarget.x-n.x, ndy = n.wanderTarget.y-n.y;
    const nd = Math.sqrt(ndx*ndx+ndy*ndy);
    if(nd>2){
      const sp = 0.3;
      const nxn = n.x+ndx/nd*sp, nyn = n.y+ndy/nd*sp;
      let moved = false;
      if(!collidesTilesOnly(nxn,n.y)){ n.x = nxn; moved = true; }
      if(!collidesTilesOnly(n.x,nyn)){ n.y = nyn; moved = true; }
      if(moved){
        if(ndx>1) n.dir = 'r'; else if(ndx<-1) n.dir = 'l';
        n.walkTimer += dt;
        if(n.walkTimer>180){ n.walkTimer = 0; n.walkPhase = (n.walkPhase+1)%4; }
      } else n.moveTimer = 0;
    }
  }

  if(Game.map==='mine'){
    for(const mon of Game.monsters){
      if(mon.hitTimer>0){ mon.hitTimer -= dt; continue; }
      const ddx = player.x+12-mon.x, ddy = player.y+24-mon.y;
      const dist = Math.sqrt(ddx*ddx+ddy*ddy);
      if(dist<80){
        const sp = 0.5;
        const nxn = mon.x+ddx/dist*sp, nyn = mon.y+ddy/dist*sp;
        if(!collidesTilesOnly(nxn, mon.y)) mon.x = nxn;
        if(!collidesTilesOnly(mon.x, nyn)) mon.y = nyn;
        mon.dir = ddx>0?1:-1;
        if(dist<22 && player.invuln<=0){
          Game.hp -= mon.dmg; player.invuln = 800; Snd.play('hurt');
          spawnParticle(player.x+12, player.y+16, '#ff2020');
          if(Game.hp<=0){
            Game.hp = Game.maxHp;
            Game.map='farmhouse'; player.x = 3*TILE; player.y = 7*TILE;
            player.targetX = null; player.targetY = null; player.actionTarget = null;
            toast('You blacked out...');
          }
        }
      } else {
        mon.moveTimer -= dt;
        if(mon.moveTimer<=0){ mon.moveTimer = 2000+Math.random()*2000;
          mon.wanderTarget = {x:mon.x+(Math.random()-0.5)*80, y:mon.y+(Math.random()-0.5)*80}; }
        const mdx = mon.wanderTarget.x-mon.x, mdy = mon.wanderTarget.y-mon.y;
        const md = Math.sqrt(mdx*mdx+mdy*mdy);
        if(md>2){ mon.x += mdx/md*0.25; mon.y += mdy/md*0.25; mon.dir = mdx>0?1:-1; }
      }
      mon.frameTimer += dt;
      if(mon.frameTimer>300){ mon.frameTimer = 0; mon.frame = (mon.frame+1)%2; }
    }
  }

  const t2 = Game.time;
  let dn = 0;
  if(t2>=6*60 && t2<8*60) dn = 0.5 - ((t2-6*60)/120)*0.5;
  else if(t2>=8*60 && t2<18*60) dn = 0;
  else if(t2>=18*60 && t2<21*60) dn = ((t2-18*60)/180)*0.6;
  else if(t2>=21*60 || t2<6*60) dn = 0.6;
  if(Game.map==='mine') dn = 0.75;
  if(Game.map==='farmhouse' || Game.map.indexOf('interior')>=0) dn = 0;
  Game.dayNight = dn;

  checkMapTransition();
}

