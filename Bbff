  for(let x=30;x<38;x++) m[27][x]=T_PATH;
  return m;
}
function makeTown(){
  const m = makeMap(60,48,T_GRASS);
  for(let x=0;x<60;x++) m[24][x]=T_PATH;
  for(let y=0;y<48;y++) m[y][30]=T_PATH;
  for(let y=22;y<28;y++) for(let x=26;x<36;x++) m[y][x]=T_FLOOR;
  for(let x=26;x<34;x++) m[47][x]=T_PATH;
  for(let x=26;x<34;x++) m[0][x]=T_PATH;
  for(let x=4;x<26;x++) m[14][x]=T_PATH;
  for(let x=34;x<56;x++) m[14][x]=T_PATH;
  for(let x=4;x<26;x++) m[35][x]=T_PATH;
  for(let x=34;x<56;x++) m[35][x]=T_PATH;
  for(let y=14;y<24;y++){ m[y][4]=T_PATH; m[y][20]=T_PATH; m[y][40]=T_PATH; m[y][56]=T_PATH; }
  for(let y=24;y<36;y++){ m[y][4]=T_PATH; m[y][20]=T_PATH; m[y][40]=T_PATH; m[y][56]=T_PATH; }
  return m;
}
function makeBeach(){
  const m = makeMap(60,48,T_SAND);
  for(let x=0;x<60;x++) m[0][x]=T_PATH;
  for(let y=24;y<48;y++) for(let x=0;x<60;x++) m[y][x]=T_WATER;
  for(let y=36;y<48;y++) for(let x=0;x<60;x++) m[y][x]=T_DEEP;
  return m;
}
function makeForest(){
  const m = makeMap(48,48,T_GRASS);
  for(let y=22;y<28;y++) m[y][0]=T_PATH;
  for(let y=22;y<28;y++) m[y][47]=T_PATH;
  for(let x=22;x<28;x++) m[0][x]=T_PATH;
  for(let y=22;y<28;y++) m[y][24]=T_PATH;
  for(let x=0;x<48;x++) m[24][x]=T_PATH;
  return m;
}
function makeMountain(){
  const m = makeMap(48,48,T_GRASS);
  for(let y=0;y<48;y++) for(let x=0;x<48;x++) if(Math.random()<0.15) m[y][x]=T_ROCK;
  for(let y=42;y<48;y++) for(let x=22;x<28;x++) m[y][x]=T_GRASS;
  for(let x=22;x<28;x++) m[0][x]=T_PATH;
  for(let y=0;y<47;y++) m[y][24]=T_PATH;
  for(let x=22;x<28;x++) m[46][x]=T_PATH;
  for(let y=12;y<18;y++) for(let x=18;x<30;x++) m[y][x]=T_WATER;
  for(let y=6;y<12;y++) for(let x=20;x<28;x++) if(m[y][x]===T_ROCK) m[y][x]=T_GRASS;
  return m;
}
function makeIndoor(w,h){
  const m = makeMap(w,h,T_IND_FLOOR);
  for(let x=0;x<w;x++){ m[0][x]=T_IND_WALL; m[h-1][x]=T_IND_WALL; }
  for(let y=0;y<h;y++){ m[y][0]=T_IND_WALL; m[y][w-1]=T_IND_WALL; }
  m[h-1][Math.floor(w/2)]=T_IND_FLOOR; m[h-1][Math.floor(w/2)+1]=T_IND_FLOOR;
  return m;
}

