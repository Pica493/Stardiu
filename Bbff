function drawChar(g,dir,frame,state,cust){
  const skin = SKIN[cust.skin]||SKIN[0], hair = HAIR[cust.hair]||HAIR[0];
  const shirt = SHIRT[cust.shirt]||SHIRT[0], pants = PANTS[cust.pants]||PANTS[0], shoes = SHOES[cust.shoes]||SHOES[0];
  const eye = '#1a1a2a', mouth = '#a05040', blush = '#d06050';
  if(state==='sleep'){
    rr(g,4,20,20,7,shirt); rr(g,2,22,5,5,skin); rr(g,22,24,4,3,shoes); rr(g,18,20,4,7,pants);
    g.fillStyle='#fff'; g.font='bold 7px monospace'; g.fillText('z',20,16); g.fillText('Z',23,11); return;
  }
  const cx = 12;
  let legL=0, legR=0, bob=0, armL=0, armR=0;
  if(state==='walk'){ const o=[0,1,0,-1]; legL=o[frame]; legR=-o[frame]; bob=(frame===1||frame===3)?-1:0; armL=o[frame]; armR=-o[frame]; }
  const fY = 31;
  if(dir==='l'||dir==='r'){
    rr(g,cx-2+legL,fY-8,3,8,pants); rr(g,cx+1+legR,fY-8,3,8,pants);
    rr(g,cx-3+legL,fY-2,4,2,shoes); rr(g,cx+1+legR,fY-2,4,2,shoes);
  } else {
    rr(g,cx-3,fY-8+legL,3,8,pants); rr(g,cx+1,fY-8+legR,3,8,pants);
    rr(g,cx-4,fY-2+legL,4,2,shoes); rr(g,cx+1,fY-2+legR,4,2,shoes);
  }
  const bT = fY-19+bob;
  rr(g,cx-5,bT,10,11,shirt); rr(g,cx-5,bT+9,10,2,'rgba(0,0,0,0.2)');
  const aY = bT+2;
  if(dir==='d' || dir==='u'){
    rr(g,cx-7,aY+armL,2,7,shirt); rr(g,cx+5,aY+armR,2,7,shirt);
    if(dir==='d'){ rr(g,cx-7,aY+armL+6,2,2,skin); rr(g,cx+5,aY+armR+6,2,2,skin); }
  } else if(dir==='l'){
    rr(g,cx-6,aY+armL,3,7,shirt); rr(g,cx+2,aY+armR,2,7,shirt); rr(g,cx-6,aY+armL+6,3,2,skin);
  } else {
    rr(g,cx+4,aY+armL,3,7,shirt); rr(g,cx-4,aY+armR,2,7,shirt); rr(g,cx+4,aY+armL+6,3,2,skin);
  }
  const hT = bT-14;
  if(dir==='l'){
    rr(g,cx-5,hT,9,12,skin); rr(g,cx+2,hT,2,12,'rgba(0,0,0,0.15)'); rr(g,cx-6,hT+2,2,8,hair);
    rr(g,cx-3,hT+6,2,2,eye); rr(g,cx-6,hT+9,2,1,blush);
  } else if(dir==='r'){
    rr(g,cx-4,hT,9,12,skin); rr(g,cx-5,hT,2,12,'rgba(0,0,0,0.15)'); rr(g,cx+4,hT+2,2,8,hair);
    rr(g,cx+1,hT+6,2,2,eye); rr(g,cx+4,hT+9,2,1,blush);
  } else if(dir==='d'){
    rr(g,cx-4,hT,8,12,skin); rr(g,cx-5,hT+1,2,9,hair); rr(g,cx+3,hT+1,2,9,hair);
    rr(g,cx-3,hT+6,2,2,eye); rr(g,cx+1,hT+6,2,2,eye); rr(g,cx-1,hT+9,2,1,mouth);
    rr(g,cx-4,hT+9,2,1,blush); rr(g,cx+2,hT+9,2,1,blush);
  } else {
    rr(g,cx-4,hT,8,12,skin); rr(g,cx-5,hT+1,10,9,hair); rr(g,cx-5,hT+6,10,4,'rgba(0,0,0,0.3)');
  }
  if(cust.hat===1){ rr(g,cx-7,hT-3,14,2,'#a88030'); rr(g,cx-6,hT-6,12,4,'#e8c060'); }
  else if(cust.hat===2){ rr(g,cx-6,hT-3,12,2,'#a03030'); rr(g,cx-5,hT-6,10,4,'#c84040'); }
  else if(cust.hat===3){ rr(g,cx-5,hT-5,10,6,'#4080c0'); }
  else if(cust.hat===4){ rr(g,cx-7,hT-2,14,3,'#3a2050'); rr(g,cx-5,hT-10,10,9,'#5a3a8a'); }
  else if(cust.hat===5){ rr(g,cx-8,hT-2,16,2,'#6a4a20'); rr(g,cx-6,hT-6,12,4,'#8a5a30'); }
  if(state==='use'){
    if(dir==='l'){ rr(g,cx-10,aY,3,3,'#8a5a30'); rr(g,cx-12,aY-3,5,4,'#a0a8b0'); }
    else if(dir==='r'){ rr(g,cx+7,aY,3,3,'#8a5a30'); rr(g,cx+8,aY-3,5,4,'#a0a8b0'); }
    else if(dir==='d'){ rr(g,cx+3,aY+4,3,3,'#8a5a30'); rr(g,cx+1,aY+7,8,4,'#a0a8b0'); }
    else { rr(g,cx-8,aY-6,3,3,'#8a5a30'); rr(g,cx-10,aY-9,5,4,'#a0a8b0'); }
  }
}
function regenerateChar(){
  for(const d of ['d','u','l','r']){
    for(let f=0;f<4;f++) spr('c_'+d+'_'+f,24,32,g=>drawChar(g,d,f,'walk',Custom));
    spr('c_'+d+'_idle',24,32,g=>drawChar(g,d,0,'idle',Custom));
    spr('c_'+d+'_use',24,32,g=>drawChar(g,d,0,'use',Custom));
    spr('c_'+d+'_sleep',24,32,g=>drawChar(g,d,0,'sleep',Custom));
  }
  for(let f=0;f<4;f++) mirror('c_r_'+f,'c_l_'+f);
  mirror('c_r_idle','c_l_idle'); mirror('c_r_use','c_l_use'); mirror('c_r_sleep','c_l_sleep');
}

