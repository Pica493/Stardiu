function startDialogue(npc){
  const db = DIALOGUE_DB[npc.id];
  if(!db){ toast(npc.name+': Hello!'); return; }
  greetNPC(npc);
  Snd.play('click');

  if(!npc.questGiven){
    const item = Game.inv[npc.quest.item]||0;
    if(item>=npc.quest.count && !npc.questDone){
      Game.inv[npc.quest.item] -= npc.quest.count;
      Game.gold += npc.quest.reward;
      npc.hearts = Math.min(10, npc.hearts+2);
      npc.questDone = true; npc.questGiven = true;
      Game.completedQuests++;
      openDialogue(npc, ["Wait — you brought me "+npc.quest.count+' '+npc.quest.item+'?!',"Here, take this reward. +"+npc.quest.reward+" gold +2♥"]);
      return;
    }
    npc.questGiven = true;
    Game.activeQuests.push({npcId:npc.id, item:npc.quest.item, count:npc.quest.count, reward:npc.quest.reward});
    openDialogue(npc, ["Actually, I could use a favor.","Could you bring me "+npc.quest.count+' '+npc.quest.item+'?',"I'll pay you "+npc.quest.reward+" gold."]);
    return;
  }

  if(npc.shop){
    openDialogue(npc, ["Hello! What can I help you with?"], [
      {text:"See your wares", effect:0, reply:"Of course!", action:()=>{ closeDialogue(); openShop(npc); }},
      {text:"Just saying hi", effect:0.2, reply:"Well, hello to you too!"},
      {text:"What's new?", effect:0.3, reply:"Same old, same old."}
    ]);
    return;
  }

  if(!npc.metBefore){
    npc.metBefore = true;
    openDialogue(npc, db.firstMeet);
    return;
  }

  if(npc.storiesSeen.length < db.stories.length){
    const nextStory = db.stories[npc.storiesSeen.length];
    if(npc.hearts >= nextStory.hearts && Math.random() < 0.4){
      npc.storiesSeen.push(nextStory);
      openDialogue(npc, nextStory.lines);
      return;
    }
  }

  const unasked = db.questions.filter(q => npc.hearts >= q.hearts && !npc.questionsAsked.includes(q));
  if(unasked.length && Math.random() < 0.5){
    const q = unasked[Math.floor(Math.random()*unasked.length)];
    npc.questionsAsked.push(q);
    openDialogue(npc, [q.question], q.options.map(o=>({text:o.text,effect:o.effect,reply:o.reply})));
    return;
  }

  const line = db.daily[Math.floor(Math.random()*db.daily.length)];
  openDialogue(npc, [line]);
}

function openDialogue(npc, lines, options){
  Game.dialogue = { npc, lines: lines.slice(), currentLine: 0, options: options || null, choices: null };
  renderDialogue();
}
function renderDialogue(){
  const d = Game.dialogue;
  if(!d) return;
  const box = $('dialogueBox');
  box.classList.add('show');
  $('dialogueName').textContent = d.npc.name;
  $('dialogueText').textContent = d.lines[d.currentLine];
  const opts = $('dialogueOptions');
  const hint = $('dialogueHint');
  opts.innerHTML = '';
  if(d.currentLine === d.lines.length - 1 && d.options && !d.choices){
    d.options.forEach((opt)=>{
      const btn = document.createElement('button');
      btn.textContent = opt.text;
      btn.onclick = (e)=>{ e.stopPropagation(); applyDialogueChoice(opt); };
      opts.appendChild(btn);
    });
    hint.textContent = '';
  } else {
    hint.textContent = t('continue');
  }
}
function applyDialogueChoice(opt){
  const d = Game.dialogue;
  if(!d) return;
  d.choices = opt;
  d.npc.hearts = Math.max(0, Math.min(10, d.npc.hearts + opt.effect));
  if(opt.effect > 0) Snd.play('giftGood');
  else if(opt.effect < 0) Snd.play('giftBad');
  else Snd.play('click');
  // Show reply FIRST
  if(opt.reply){
    const effectStr = opt.effect > 0 ? ' (+'+opt.effect+'♥)' : opt.effect < 0 ? ' ('+opt.effect+'♥)' : '';
    d.lines.push(opt.reply + effectStr);
    d.currentLine = d.lines.length - 1;
    d.options = null;
    renderDialogue();
    // If action, run after a short delay so reply is visible
    if(opt.action) setTimeout(()=>{ closeDialogue(); opt.action(); }, 700);
    return;
  }
  if(opt.action){ closeDialogue(); opt.action(); return; }
  d.currentLine = d.lines.length - 1;
  d.options = null;
  renderDialogue();
}
function advanceDialogue(){
  const d = Game.dialogue;
  if(!d) return;
  if(d.currentLine < d.lines.length - 1){ d.currentLine++; renderDialogue(); }
  else closeDialogue();
}
function closeDialogue(){ Game.dialogue = null; $('dialogueBox').classList.remove('show'); }
$('dialogueBox').addEventListener('pointerdown', (e)=>{
  e.stopPropagation();
  if(e.target.tagName === 'BUTTON') return;
  advanceDialogue();
});

