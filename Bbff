function loop(now){
  let dt = now-lastTime;
  lastTime = now;
  if(dt>100) dt = 100;
  if(dt<0) dt = 0;
  try{
    update(dt);
    ctx.setTransform(1,0,0,1,0,0);
    ctx.fillStyle = '#000'; ctx.fillRect(0,0,CW,CH);
    ctx.setTransform(SCALE,0,0,SCALE,0,0);
    drawWorld();
    if(!Game.paused && !Game.menuOpen && !Game.dialogue && !$('elevatorMenu').classList.contains('show')) drawHUD();
  }catch(e){ console.error(e); }
  requestAnimationFrame(loop);
}

