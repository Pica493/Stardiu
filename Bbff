function currentMap(){ return World[Game.map]; }
function toolName(tt){ return {axe:'Axe',pick:'Pickaxe',hoe:'Hoe',can:'Can',seed:'Seeds',rod:'Rod',sword:'Sword'}[tt]; }
function tileAt(tx,ty){
  const m = currentMap();
  if(!m.tiles || !m.tiles[ty]) return T_ROCK;
  if(ty<0||ty>=m.tiles.length||tx<0||tx>=m.tiles[0].length) return T_ROCK;
  return m.tiles[ty][tx];
}
function findObjectAt(tx,ty){
  const m = currentMap();
  if(!m.objects) return null;
  for(const o of m.objects) if(tx===o.tx && ty===o.ty) return o;
  return null;
}
function findNPCAt(tx,ty){
  const wp = {x:tx*TILE+TILE/2, y:ty*TILE+TILE/2};
  for(const n of NPC_DATA){
    if(n.loc!==Game.map) continue;
    if(Math.abs(n.x-wp.x)<22 && Math.abs(n.y-wp.y)<24) return n;
  }
  return null;
}
function findMonsterAt(tx,ty){
  const wp = {x:tx*TILE+TILE/2, y:ty*TILE+TILE/2};
  for(const m of Game.monsters) if(Math.abs(m.x-wp.x)<16 && Math.abs(m.y-wp.y)<16) return m;
  return null;
}
function toast(txt){
  Game.toast = txt; Game.toastTimer = 1500;
  const e = $('notify'); if(!e) return;
  e.textContent = txt; e.classList.add('show');
  clearTimeout(toast._t); toast._t = setTimeout(()=>e.classList.remove('show'), 1500);
}
function fadeTo(cb){
  const f = $('fade'); if(!f){ cb(); return; }
  f.classList.add('active');
  setTimeout(()=>{ cb(); setTimeout(()=>f.classList.remove('active'),80); }, 300);
}
function checkSkillUp(s){
  const xp = Game.skillXp[s];
  const lvl = Math.floor(Math.sqrt(xp/10));
  if(lvl > Game.skills[s]){ Game.skills[s] = Math.min(10, lvl); toast(s+' Lv '+Game.skills[s]); }
}
function addSkill(s, n){ Game.skillXp[s] = (Game.skillXp[s]||0)+n; checkSkillUp(s); }
function addAchieve(id, name){ if(Game.achieved.includes(id)) return; Game.achieved.push(id); toast('🏆 '+name); Snd.play('levelup'); }

function currentWeek(){ return Math.floor((Game.day-1)/7)+1; }
function greetNPC(npc){
  if(npc.greetedToday) return false;
  npc.greetedToday = true; npc.lastTalkedDay = Game.day;
  if(npc.hearts < 10) npc.hearts = Math.min(10, npc.hearts + 0.15);
  Snd.play('greet'); return true;
}
function giveGift(npc, itemId){
  const w = currentWeek();
  if(npc.giftWeek !== w){ npc.giftWeek = w; npc.giftCount = 0; npc.giftToday = false; }
  if(npc.giftToday){ toast('Already gifted today'); Snd.play('error'); return false; }
  if(npc.giftCount >= 2){ toast('Weekly limit reached'); Snd.play('error'); return false; }
  if((Game.inv[itemId]||0) <= 0){ toast('No '+itemId); Snd.play('error'); return false; }
  Game.inv[itemId]--;
  let delta = 0.5;
  if(itemId === npc.fav) delta = 2;
  else if(itemId === npc.disliked) delta = -1;
  npc.hearts = Math.max(0, Math.min(10, npc.hearts + delta));
  npc.giftCount++; npc.giftToday = true; npc.lastTalkedDay = Game.day;
  if(delta > 0){ Snd.play('giftGood'); toast(npc.name+' liked '+itemId+'! +'+delta+'♥'); }
  else if(delta < 0){ Snd.play('giftBad'); toast(npc.name+' disliked '+itemId+'!'); }
  return true;
}
function decayFriendship(){
  for(const npc of NPC_DATA){
    npc.greetedToday = false; npc.giftToday = false;
    if(npc.giftWeek !== currentWeek()){ npc.giftWeek = currentWeek(); npc.giftCount = 0; }
    if(npc.hearts >= 10) continue;
    const daysSilent = Game.day - (npc.lastTalkedDay || 0);
    if(daysSilent >= 3 && npc.hearts > 0) npc.hearts = Math.max(0, npc.hearts - 0.5);
  }
}

