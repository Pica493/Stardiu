<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no,viewport-fit=cover">
<title>Pixel Farm</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{width:100vw;height:100vh;overflow:hidden;background:#0a0a1a;font-family:'Courier New',monospace;color:#fff;user-select:none;touch-action:none;position:fixed;top:0;left:0}
#cv{display:block;image-rendering:pixelated;image-rendering:crisp-edges;touch-action:none;cursor:pointer;position:absolute}
.screen{position:fixed;inset:0;display:flex;flex-direction:column;justify-content:center;align-items:center;background:linear-gradient(135deg,#3a4a3a,#1a1a2a 60%,#0d0d0d);z-index:100;padding:16px;gap:10px;overflow-y:auto;touch-action:manipulation}
.screen.hidden{display:none}
.screen h1{font-size:clamp(28px,8vw,64px);letter-spacing:6px;color:#e8c060;text-shadow:0 4px 0 #5a3a1a;margin-bottom:8px;text-align:center}
.screen h2{font-size:clamp(16px,4vw,22px);color:#e8c060;margin-bottom:8px;letter-spacing:3px}
.screen button{background:#3a2a1a;color:#ffe8b0;border:3px solid #8a5a2a;padding:12px 26px;font-size:clamp(12px,3vw,15px);cursor:pointer;border-radius:4px;font-family:inherit;letter-spacing:2px;min-width:200px;max-width:92vw;font-weight:bold;touch-action:manipulation;pointer-events:auto}
.screen button:hover,.screen button:active{background:#5a3a1a;border-color:#e8c060}
.screen button.primary{background:#4a7a2a;border-color:#8ac04a;color:#f0ffe0}
.lang-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;max-width:500px;width:100%;padding:8px}
.lang-btn{background:#3a2a1a;color:#ffe8b0;border:2px solid #8a5a2a;padding:14px;font-size:15px;cursor:pointer;border-radius:6px;font-family:inherit;display:flex;align-items:center;gap:10px;font-weight:bold;touch-action:manipulation}
#notify{position:fixed;top:60px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,.9);color:#ffe8b0;padding:8px 16px;border-radius:4px;font-size:12px;z-index:150;opacity:0;transition:opacity .25s;pointer-events:none;border:2px solid #8a5a2a;font-weight:bold;max-width:80vw;text-align:center}
#notify.show{opacity:1}
#fade{position:fixed;inset:0;background:#0a0a1a;opacity:0;pointer-events:none;z-index:60;transition:opacity .4s}
#fade.active{opacity:1}
#centerText{position:fixed;inset:0;display:none;flex-direction:column;justify-content:center;align-items:center;z-index:61;pointer-events:none;color:#ffe8b0;gap:8px;text-align:center;text-shadow:0 2px 12px #000}
#centerText.show{display:flex}
#centerText .big{font-size:clamp(20px,5vw,34px);letter-spacing:3px;color:#e8c060}
#centerText .small{font-size:clamp(11px,3vw,14px);color:#8ac04a}
#gameMenu{position:fixed;inset:0;background:linear-gradient(135deg,rgba(58,42,20,.97),rgba(30,20,10,.98));z-index:120;display:none;padding:6px;touch-action:manipulation}
#gameMenu.show{display:block}
.menu-wrap{display:flex;flex-direction:column;height:100%;gap:6px;max-width:1100px;margin:0 auto;width:100%}
.menu-top{display:flex;gap:6px;align-items:center;padding:8px 12px;background:#2a1a0a;border:3px solid #8a5a2a;border-radius:4px;flex-wrap:wrap;font-size:11px}
.menu-top .name{color:#e8c060;font-weight:bold;font-size:14px;letter-spacing:2px}
.menu-top .info{color:#ffe8b0;margin-left:auto;display:flex;gap:10px;flex-wrap:wrap}
.menu-body{display:flex;flex:1;gap:6px;min-height:0;flex-direction:column}
.menu-tabs{display:flex;gap:4px;overflow-x:auto;padding-bottom:4px;-webkit-overflow-scrolling:touch;scrollbar-width:thin}
.menu-tabs::-webkit-scrollbar{height:4px}
.menu-tabs::-webkit-scrollbar-thumb{background:#5a3a1a;border-radius:2px}
.tab-btn{background:#3a2a1a;color:#ffe8b0;border:2px solid #8a5a2a;padding:8px 12px;font-size:10px;cursor:pointer;border-radius:3px;font-family:inherit;font-weight:bold;white-space:nowrap;touch-action:manipulation;letter-spacing:1px;flex-shrink:0}
.tab-btn.active{background:#4a7a2a;border-color:#e8c060;color:#fff;box-shadow:0 0 8px rgba(232,192,96,.4)}
.menu-content{flex:1;background:#1a1208;border:3px solid #8a5a2a;border-radius:4px;padding:12px;overflow-y:auto;min-width:0;-webkit-overflow-scrolling:touch;touch-action:pan-y}
.menu-content h3{color:#e8c060;font-size:13px;letter-spacing:2px;margin-bottom:8px;border-bottom:1px solid #5a3a1a;padding-bottom:4px}
.inv-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:4px}
.inv-item{background:#2a1a0a;border:2px solid #5a3a1a;padding:6px 8px;border-radius:3px;display:flex;justify-content:space-between;font-size:11px;color:#ffe8b0;align-items:center;gap:6px;flex-wrap:wrap}
.inv-item .count{color:#e8c060;font-weight:bold}
.inv-item button{background:#4a7a2a;border:1px solid #8ac04a;color:#ffe8b0;padding:3px 8px;font-size:10px;cursor:pointer;font-family:inherit;border-radius:3px;touch-action:manipulation}
.inv-item button:disabled{opacity:.35;cursor:not-allowed}
.stat-row{display:flex;justify-content:space-between;padding:6px 10px;background:#2a1a0a;margin-bottom:3px;border-radius:3px;font-size:11px;align-items:center}
.social-card{background:#2a1a0a;border:2px solid #5a3a1a;border-radius:4px;padding:8px;margin-bottom:6px}
.social-card.friend{border-color:#8ac04a}
.social-card.best{border-color:#ff6080;background:#3a1a1a}
.social-head{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:4px}
.social-head .nm{color:#ffe8b0;font-weight:bold;font-size:12px}
.social-head .role{color:#8ac04a;font-size:10px}
.social-persona{color:#a08060;font-size:10px;font-style:italic;margin-bottom:4px}
.social-hearts{color:#ff6080;font-size:11px;margin-bottom:4px;letter-spacing:-1px}
.social-status{font-size:10px;color:#8ac04a;display:flex;flex-wrap:wrap;gap:8px;margin-bottom:4px}
.social-actions{display:flex;gap:4px;flex-wrap:wrap;margin-top:4px}
.social-actions button{min-width:auto;padding:4px 10px;font-size:10px;background:#4a7a2a;border:1px solid #8ac04a;color:#ffe8b0;cursor:pointer;font-family:inherit;border-radius:3px;touch-action:manipulation}
.social-actions button:disabled{opacity:0.4;cursor:not-allowed}
.social-actions button.gift{background:#5a4a2a;border-color:#c8a040}
.map-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}
.map-cell{background:#2a1a0a;border:2px solid #5a3a1a;padding:10px;border-radius:3px;text-align:center;font-size:11px;color:#ffe8b0}
.map-cell b{color:#e8c060;display:block;margin-bottom:3px}
.map-cell.here{background:#4a7a2a;border-color:#8ac04a}
.options-row{display:flex;justify-content:space-between;align-items:center;padding:8px;background:#2a1a0a;margin-bottom:4px;border-radius:3px;font-size:11px;color:#ffe8b0;gap:8px;flex-wrap:wrap}
.swatch{width:24px;height:24px;border:2px solid #8a5a2a;border-radius:3px;cursor:pointer;display:inline-block;touch-action:manipulation}
.swatch.active{border-color:#e8c060;box-shadow:0 0 8px #e8c060}
.color-row{display:flex;gap:4px;flex-wrap:wrap;margin-top:4px}
.menu-bottom{display:flex;gap:6px;justify-content:flex-end;padding-top:4px;flex-wrap:wrap}
.menu-bottom button{min-width:100px;padding:10px 16px;font-size:12px;font-weight:bold;background:#3a2a1a;color:#ffe8b0;border:3px solid #8a5a2a;font-family:inherit;cursor:pointer;border-radius:4px;touch-action:manipulation}
.menu-bottom button.primary{background:#4a7a2a;border-color:#8ac04a}
.menu-bottom button.danger{background:#6a2020;border-color:#a04040}
.museum-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(110px,1fr));gap:4px}
.museum-slot{background:#1a1208;border:2px solid #4a3a1a;padding:6px;border-radius:3px;text-align:center;font-size:10px;color:#666;min-height:60px;display:flex;flex-direction:column;justify-content:center;align-items:center}
.museum-slot.filled{border-color:#e8c060;color:#ffe8b0;background:#2a1a0a}
.museum-slot .nm{color:#e8c060;font-weight:bold;font-size:10px;margin-bottom:2px}
#dialogueBox{position:fixed;left:50%;bottom:20px;transform:translateX(-50%);width:min(700px,94vw);background:linear-gradient(135deg,#2a1a0a,#1a1208);border:3px solid #8a5a2a;border-radius:6px;padding:14px 18px;z-index:130;display:none;box-shadow:0 8px 30px rgba(0,0,0,.8)}
#dialogueBox.show{display:block;animation:slideUp .2s ease-out}
@keyframes slideUp{from{transform:translate(-50%,20px);opacity:0}to{transform:translate(-50%,0);opacity:1}}
#dialogueBox .dname{color:#e8c060;font-weight:bold;font-size:14px;letter-spacing:1px;margin-bottom:6px}
#dialogueBox .dtext{color:#ffe8b0;font-size:13px;line-height:1.6;min-height:42px}
#dialogueBox .dopts{display:flex;flex-direction:column;gap:6px;margin-top:10px}
#dialogueBox .dopts button{background:#3a2a1a;color:#ffe8b0;border:2px solid #8a5a2a;padding:10px 14px;font-size:12px;cursor:pointer;border-radius:4px;font-family:inherit;text-align:left;width:100%;touch-action:manipulation}
#dialogueBox .dopts button:hover,#dialogueBox .dopts button:active{background:#5a3a1a;border-color:#e8c060}
#dialogueBox .dhint{color:#8ac04a;font-size:10px;text-align:right;margin-top:8px;opacity:.8}
#loadingScreen .bar{width:300px;max-width:80vw;height:14px;background:#1a1a0a;border:2px solid #8a5a2a;border-radius:4px;overflow:hidden}
#loadBar{width:0%;height:100%;background:linear-gradient(90deg,#8ac04a,#e8c060);transition:width .15s}
#elevatorMenu{position:fixed;inset:0;background:rgba(0,0,0,.85);z-index:140;display:none;justify-content:center;align-items:center;padding:20px}
#elevatorMenu.show{display:flex}
#elevatorMenu .panel{background:linear-gradient(135deg,#2a1a0a,#1a1208);border:3px solid #8a5a2a;border-radius:8px;padding:20px;max-width:400px;width:100%;max-height:80vh;overflow-y:auto}
#elevatorMenu h3{color:#e8c060;text-align:center;margin-bottom:14px;letter-spacing:2px}
#elevatorMenu .floor-btn{display:block;width:100%;background:#3a2a1a;color:#ffe8b0;border:2px solid #8a5a2a;padding:12px;margin-bottom:6px;font-family:inherit;font-size:13px;cursor:pointer;border-radius:4px;touch-action:manipulation;font-weight:bold}
#elevatorMenu .floor-btn:hover,#elevatorMenu .floor-btn:active{background:#5a3a1a;border-color:#e8c060}
#elevatorMenu .floor-btn.surface{background:#4a7a2a;border-color:#8ac04a}
@media(max-width:600px){.menu-top .info{font-size:10px;gap:6px}.inv-grid{grid-template-columns:repeat(auto-fill,minmax(120px,1fr))}}
</style>
</head>
<body>
<canvas id="cv" width="960" height="720"></canvas>
<div id="notify"></div><div id="fade"></div><div id="centerText"></div>

<div id="dialogueBox">
  <div class="dname" id="dialogueName">NPC</div>
  <div class="dtext" id="dialogueText">...</div>
  <div class="dopts" id="dialogueOptions"></div>
  <div class="dhint" id="dialogueHint">Click to continue ▶</div>
</div>

<div id="elevatorMenu">
  <div class="panel">
    <h3>🛗 ELEVATOR</h3>
    <div id="elevatorFloors"></div>
    <button class="floor-btn" onclick="closeElevator()" style="background:#6a2020;border-color:#a04040;margin-top:12px">✕ Close</button>
  </div>
</div>

<div id="loadingScreen" class="screen">
  <h1>PIXEL FARM</h1>
  <div style="color:#8ac04a;font-size:13px;letter-spacing:2px;margin-bottom:12px" id="loadText">Loading...</div>
  <div class="bar"><div id="loadBar"></div></div>
  <div style="color:#a08060;font-size:10px;margin-top:8px" id="loadPct">0%</div>
</div>

<div id="langSelect" class="screen hidden">
  <h1>PIXEL FARM</h1>
  <h2>Choose your language / Выберите язык</h2>
  <div class="lang-grid" id="langGrid"></div>
</div>

<div id="menuMain" class="screen hidden">
  <h1>PIXEL FARM</h1>
  <button id="btnNew" class="primary">New Game</button>
  <button id="btnContinue">Continue</button>
  <button id="btnHelp">Help</button>
</div>

<div id="menuHelp" class="screen hidden">
  <h2>How to Play</h2>
  <div id="helpBody" style="max-width:560px;text-align:left;font-size:12px;line-height:1.9;color:#ffe8b0"></div>
  <button id="btnHelpBack">Back</button>
</div>

<div id="endingScreen" class="screen hidden">
  <h1 style="font-size:clamp(32px,10vw,72px);color:#e8c060">THE END</h1>
  <div style="max-width:600px;text-align:center;font-size:14px;line-height:2;color:#ffe8b0;margin:20px 0">
    <p>You completed the Museum collection!</p>
    <p style="color:#8ac04a;margin-top:20px" id="endingStats"></p>
  </div>
  <button onclick="location.reload()" class="primary">Play Again</button>
</div>

<div id="gameMenu">
  <div class="menu-wrap">
    <div class="menu-top">
      <span class="name" id="playerName">Farmer</span>
      <span class="info">
        <span id="menuDay">Day 1 • Spring</span>
        <span id="menuTime">06:00</span>
        <span id="menuGold">🪙 80</span>
        <span id="menuWeather">☀️ Sunny</span>
        <span id="menuForecast" style="color:#a08060"></span>
      </span>
    </div>
    <div class="menu-body">
      <div class="menu-tabs" id="menuTabs">
        <button class="tab-btn active" data-tab="inventory">INVENTORY</button>
        <button class="tab-btn" data-tab="craft">CRAFT</button>
        <button class="tab-btn" data-tab="quests">QUESTS</button>
        <button class="tab-btn" data-tab="museum">MUSEUM</button>
        <button class="tab-btn" data-tab="skills">SKILLS</button>
        <button class="tab-btn" data-tab="social">SOCIAL</button>
        <button class="tab-btn" data-tab="map">MAP</button>
        <button class="tab-btn" data-tab="custom">CHARACTER</button>
        <button class="tab-btn" data-tab="options">OPTIONS</button>
      </div>
      <div class="menu-content" id="menuContent"></div>
    </div>
    <div class="menu-bottom">
      <button id="btnMenuResume" class="primary">Resume</button>
      <button id="btnMenuSave">Save</button>
      <button id="btnMenuMain" class="danger">Main Menu</button>
    </div>
  </div>
</div>

<script>
'use strict';

// ============================================================
// I18N
// ============================================================
const $ = id => document.getElementById(id);
let LANG = localStorage.getItem('pixelfarm_lang') || 'en';
const I18N = {
  en:{newGame:'New Game',cont:'Continue',controls:'Help',back:'Back',resume:'Resume',save:'Save',mainMenu:'Main Menu',
    inventory:'Inventory',craft:'Craft',quests:'Quests',museum:'Museum',skills:'Skills',social:'Social',map:'Map',character:'Character',options:'Options',
    day:'Day',gold:'Gold',farm:'Farm',town:'Town',beach:'Beach',forest:'Forest',mountain:'Mountain',mine:'Mine',house:'Farmhouse',
    spring:'Spring',summer:'Summer',fall:'Fall',winter:'Winter',sunny:'Sunny',rain:'Rain',storm:'Storm',snow:'Snow',fog:'Fog',
    helpText:'Tap ground to walk. Tap NPCs to talk. Tap doors to enter. Tap monsters to fight. Use HUD buttons (top-right) to open menu. I=Inventory, C=Craft, M=Map, Esc=Menu, H=Horse.',
    farming:'Farming',mining:'Mining',fishing:'Fishing',combat:'Combat',foraging:'Foraging',
    donate:'Donate',donated:'Donated',crafted:'Crafted',greet:'Greet',gift:'Gift',
    continue:'Continue ▶',saved:'Saved!',use:'Use',autosaved:'Auto-saved',noActiveQuests:'No active quests'},
  ru:{newGame:'Новая игра',cont:'Продолжить',controls:'Управление',back:'Назад',resume:'Продолжить',save:'Сохранить',mainMenu:'В главное меню',
    inventory:'Инвентарь',craft:'Крафт',quests:'Задания',museum:'Музей',skills:'Навыки',social:'Знакомые',map:'Карта',character:'Персонаж',options:'Настройки',
    day:'День',gold:'Золото',farm:'Ферма',town:'Город',beach:'Пляж',forest:'Лес',mountain:'Горы',mine:'Шахта',house:'Дом',
    spring:'Весна',summer:'Лето',fall:'Осень',winter:'Зима',sunny:'Ясно',rain:'Дождь',storm:'Гроза',snow:'Снег',fog:'Туман',
    helpText:'Тап по земле — идти. Тап по NPC — говорить. Тап по двери — войти. Тап по монстру — атака. Кнопки вверху справа. I=Инвентарь, C=Крафт, M=Карта, Esc=Меню, H=Лошадь.',
    farming:'Фермерство',mining:'Горное дело',fishing:'Рыбалка',combat:'Бой',foraging:'Собирательство',
    donate:'Сдать',donated:'Сдано',crafted:'Создано',greet:'Поздороваться',gift:'Подарить',
    continue:'Продолжить ▶',saved:'Сохранено!',use:'Использовать',autosaved:'Авто-сохр.',noActiveQuests:'Нет активных заданий'}
};
function t(k){ return (I18N[LANG]&&I18N[LANG][k]) || I18N.en[k] || k; }

const cv = $('cv');
const ctx = cv.getContext('2d',{alpha:false});
const TILE = 16, CW = 960, CH = 720, LW = 480, LH = 360, SCALE = 2;

function fitCanvas(){
  const vw = innerWidth, vh = innerHeight, r = 4/3;
  let w, h;
  if(vw/vh > r){ h = vh; w = vh*r; } else { w = vw; h = vw/r; }
  cv.style.width = w+'px'; cv.style.height = h+'px';
  cv.style.left = ((vw-w)/2)+'px'; cv.style.top = ((vh-h)/2)+'px';
}
addEventListener('resize', fitCanvas);
addEventListener('orientationchange', ()=>setTimeout(fitCanvas,80));
fitCanvas();

// ============================================================
// AUDIO (with sound toggle + master volume)
// ============================================================
const Snd = {
  ctx:null, master:null, musicGain:null, sfxGain:null, activeNodes:[], mt:null, playing:false, max:4,
  enabled: localStorage.getItem('pixelfarm_sound') !== 'off',
  init(){
    if(this.ctx) return;
    try{
      const AC = window.AudioContext||window.webkitAudioContext;
      if(!AC) return;
      this.ctx = new AC();
      this.master = this.ctx.createGain(); this.master.gain.value = this.enabled?0.22:0; this.master.connect(this.ctx.destination);
      this.musicGain = this.ctx.createGain(); this.musicGain.gain.value = 0.06; this.musicGain.connect(this.master);
      this.sfxGain = this.ctx.createGain(); this.sfxGain.gain.value = 0.85; this.sfxGain.connect(this.master);
    }catch(e){}
  },
  setEnabled(on){ this.enabled = on; localStorage.setItem('pixelfarm_sound', on?'on':'off');
    if(this.master) this.master.gain.value = on?0.22:0;
    if(!on) this.stopMusic(); else if(Game && !Game.paused && !Game.menuOpen) this.startMusic();
  },
  resume(){ try{ if(this.ctx && this.ctx.state==='suspended') this.ctx.resume(); }catch(e){} },
  beep(f1,f2,dur,type,vol){
    if(!this.ctx || !this.enabled || this.activeNodes.length >= this.max) return;
    try{
      const now = this.ctx.currentTime;
      const osc = this.ctx.createOscillator();
      osc.type = type||'square';
      osc.frequency.setValueAtTime(f1,now);
      if(f2) osc.frequency.exponentialRampToValueAtTime(f2,now+dur);
      const g = this.ctx.createGain();
      g.gain.setValueAtTime(vol||0.15,now);
      g.gain.exponentialRampToValueAtTime(0.001,now+dur);
      osc.connect(g).connect(this.sfxGain);
      osc.start(now); osc.stop(now+dur+0.02);
      this.activeNodes.push({node:osc, t:performance.now()+dur*1000+100});
      if(this.activeNodes.length>this.max){ const o = this.activeNodes.shift(); try{o.node.stop();}catch(e){} }
    }catch(e){}
  },
  play(type){
    const map = {
      step:[400,400,0.04,'sine',0.04], chop:[200,70,0.12,'square',0.15],
      pick:[1400,500,0.06,'square',0.1], plant:[500,800,0.1,'sine',0.08],
      water:[2000,1500,0.08,'sine',0.08], harvest:[523,784,0.15,'sine',0.1],
      fish:[440,1046,0.2,'triangle',0.12], coin:[880,1320,0.1,'square',0.08],
      click:[900,900,0.03,'square',0.04], error:[200,100,0.14,'sawtooth',0.06],
      hurt:[300,100,0.18,'sawtooth',0.13], hit:[400,120,0.09,'square',0.13],
      levelup:[523,1318,0.35,'triangle',0.11], sleep:[100,60,0.9,'sine',0.09],
      door:[300,500,0.12,'square',0.08], moo:[180,120,0.4,'sawtooth',0.1],
      cluck:[800,500,0.09,'square',0.05], neigh:[600,300,0.3,'sawtooth',0.1],
      donate:[392,784,0.5,'sine',0.1], greet:[600,900,0.1,'sine',0.08],
      giftGood:[523,1046,0.3,'triangle',0.13], giftBad:[300,150,0.3,'sawtooth',0.1],
      elevator:[300,600,0.15,'triangle',0.12], eat:[400,600,0.15,'sine',0.1]
    };
    if(map[type]) this.beep.apply(this, map[type]);
  },
  startMusic(){
    if(!this.ctx || this.playing || !this.enabled) return;
    this.playing = true;
    const mel = [392,440,494,587,523,494,440,392,349,392,440,494,440,392,349,330,294,330,349,392];
    const dur = [.4,.4,.4,.8,.4,.4,.4,.8,.4,.4,.4,1.2,.4,.4,.4,.8,.4,.4,.4,1.2];
    let i = 0;
    const step = ()=>{
      if(!this.playing || !this.ctx) return;
      try{
        const n = this.ctx.currentTime;
        const o = this.ctx.createOscillator(); o.type='triangle'; o.frequency.value = mel[i];
        const g = this.ctx.createGain();
        g.gain.setValueAtTime(0,n); g.gain.linearRampToValueAtTime(0.3,n+0.03);
        g.gain.linearRampToValueAtTime(0.07,n+dur[i]*0.5); g.gain.linearRampToValueAtTime(0,n+dur[i]);
        o.connect(g).connect(this.musicGain); o.start(n); o.stop(n+dur[i]);
      }catch(e){}
      i = (i+1)%mel.length;
    };
    step(); this.mt = setInterval(step, 480);
  },
  stopMusic(){ this.playing = false; if(this.mt){ clearInterval(this.mt); this.mt = null; } },
  stopAll(){ for(const a of this.activeNodes){ try{a.node.stop();}catch(e){} } this.activeNodes = []; this.stopMusic(); }
};
