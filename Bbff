function drawTile(t2,x,y){
  const s = Game.season;
  if(t2===0){ const v = (x ^ y) & 3; ctx.drawImage(S['t_grass_'+s+'_'+v], x, y); return; }
  switch(t2){
    case T_PATH: ctx.drawImage(S['t_dirt'], x, y); break;
    case T_WATER: ctx.drawImage(S['t_water_'+waterFrame], x, y); break;
    case T_DEEP: ctx.drawImage(S['t_deep'], x, y); break;
    case T_TILL: ctx.drawImage(S['t_till'], x, y); break;
    case T_TILL_WET: ctx.drawImage(S['t_till_wet'], x, y); break;
    case T_FLOOR: ctx.drawImage(S['t_floor'], x, y); break;
    case T_WALL: ctx.drawImage(S['t_wall'], x, y); break;
    case T_SAND: ctx.drawImage(S['t_sand'], x, y); break;
    case T_ROCK: ctx.drawImage(S['t_rock'], x, y); break;
    case T_CAVE: ctx.drawImage(S['t_cave'], x, y); break;
    case T_CU: ctx.drawImage(S['t_copper'], x, y); break;
    case T_IR: ctx.drawImage(S['t_iron'], x, y); break;
    case T_GO: ctx.drawImage(S['t_gold'], x, y); break;
    case T_IRID: ctx.drawImage(S['t_iri'], x, y); break;
    case T_IND_FLOOR: ctx.drawImage(S['t_indoor_floor'], x, y); break;
    case T_IND_WALL: ctx.drawImage(S['t_indoor_wall'], x, y); break;
    case T_RUG: ctx.drawImage(S['t_rug'], x, y); break;
  }
}
function drawObject(o){
  let key = null, w = 16, h = 16;
  if(o.type==='tree'){ key='tree_'+Game.season; w=48; h=72; }
  else if(o.type==='pine'){ key='pine_'+Game.season; w=48; h=72; }
  else if(o.type==='rock_s'){ key='rock_s'; w=16; h=14; }
  else if(o.type==='rock_m'){ key='rock_m'; w=24; h=20; }
  else if(o.type==='rock_l'){ key='rock_l'; w=32; h=26; }
  else if(o.type==='crop'){ key='crop_'+o.cropType+'_'+o.stage; w=16; h=16; }
  else if(o.type==='bed'){ key='bed'; w=32; h=48; }
  else if(o.type==='bed_canopy'){ key='bed_canopy'; w=34; h=52; }
  else if(o.type==='table'){ key='table'; w=40; h=28; }
  else if(o.type==='desk_fancy'){ key='desk_fancy'; w=40; h=26; }
  else if(o.type==='chest'){ key='chest'; w=24; h=20; }
  else if(o.type==='bookshelf'){ key='bookshelf'; w=28; h=44; }
  else if(o.type==='plant'){ key='plant'; w=20; h=28; }
  else if(o.type==='lamp_post'){ key='lamp_post'; w=10; h=24; }
  else if(o.type==='workbench'){ key='workbench'; w=40; h=24; }
  else if(o.type==='furnace'){ key='furnace'; w=32; h=32; }
  else if(o.type==='flower_r'||o.type==='flower_y'||o.type==='flower_b'||o.type==='flower_w'||o.type==='mushroom'){ key=o.type; w=8; h=10; }
  else if(S[o.type]){ key=o.type; w=S[o.type].width; h=S[o.type].height; }
  if(!key || !S[key]) return;
  const dx = Math.round(o.x - w/2);
  const dy = Math.round(o.y - h);
  ctx.drawImage(S[key], dx, dy);
  if(o.hp!==undefined && o.maxHp!==undefined && o.hp<o.maxHp){
    const bw = 20, bx = Math.round(o.x-bw/2), by = dy-6;
    ctx.fillStyle = '#000'; ctx.fillRect(bx,by,bw,3);
    ctx.fillStyle = '#c04030'; ctx.fillRect(bx+1,by+1,(bw-2)*(o.hp/o.maxHp),1);
  }
}
function drawPlayer(){
  if(Game.onHorse){
    const hk = player.dir==='l' ? 'h_l_' : 'h_r_';
    const hf = player.walkPhase % 2;
    const hsp = S[hk+hf];
    if(hsp) ctx.drawImage(hsp, Math.round(player.x-12), Math.round(player.y+2));
  }
  ctx.drawImage(S['shadow'], Math.round(player.x), Math.round(player.y+22));
  let key;
  if(player.action==='sleep') key = 'c_'+player.dir+'_sleep';
  else if(player.action==='use') key = 'c_'+player.dir+'_use';
  else if(player.walkPhase>0) key = 'c_'+player.dir+'_'+player.walkPhase;
  else key = 'c_'+player.dir+'_idle';
  const sp = S[key] || S['c_d_idle'];
  if(player.invuln>0 && Math.floor(performance.now()/80)%2===0) ctx.globalAlpha = 0.5;
  const yOff = Game.onHorse ? -8 : 0;
  ctx.drawImage(sp, Math.round(player.x), Math.round(player.y+yOff));
  ctx.globalAlpha = 1;
}
function drawAnimal(a){
  let key;
  if(a.growthStage<1) key = ANIMAL_TYPES[a.type].baby;
  else if(a.type==='chicken') key = 'a_chicken'+(a.frame?'_1':'');
  else if(a.type==='duck') key = 'a_duck'+(a.frame?'_1':'');
  else if(a.type==='rabbit') key = 'a_rabbit'+(a.frame?'_1':'');
  else if(a.type==='pig') key = 'a_pig'+(a.frame?'_1':'');
  else if(a.type==='cow') key = 'a_cow'+(a.frame?'_1':'');
  else if(a.type==='goat') key = 'a_goat'+(a.frame?'_1':'');
  else if(a.type==='horse'){ if(a.mounted) return; key = 'h_r_'+(a.frame?1:0); }
  const sp = S[key]; if(!sp) return;
  const w = sp.width, h = sp.height;
  ctx.drawImage(S['shadow'], Math.round(a.x-w/2), Math.round(a.y-4));
  if(a.dir<0){
    ctx.save(); ctx.translate(Math.round(a.x)+w/2, 0); ctx.scale(-1,1); ctx.translate(-(Math.round(a.x)+w/2), 0);
    ctx.drawImage(sp, Math.round(a.x-w/2), Math.round(a.y-h)); ctx.restore();
  } else ctx.drawImage(sp, Math.round(a.x-w/2), Math.round(a.y-h));
  if(a.produceReady && a.growthStage>=1 && a.type!=='horse'){
    const bob = Math.sin(performance.now()/300)*1.5;
    ctx.font = 'bold 10px sans-serif'; ctx.fillStyle = '#fff';
    ctx.fillText(ANIMAL_TYPES[a.type].icon, Math.round(a.x-5), Math.round(a.y-h-4+bob));
  }
}
function drawNPC(n){
  const idx = NPC_DATA.indexOf(n);
  const sp = S['npc'+idx+'_'+n.dir] || S['npc'+idx+'_d'];
  if(!sp) return;
  ctx.drawImage(S['shadow'], Math.round(n.x-14), Math.round(n.y-4));
  ctx.drawImage(sp, Math.round(n.x-12), Math.round(n.y-32));
  if(n.hearts>0){
    ctx.font = 'bold 8px sans-serif'; ctx.fillStyle = '#ff6080';
    ctx.fillText('♥'+Math.floor(n.hearts), Math.round(n.x-4), Math.round(n.y-36));
  }
  if(n.questGiven && !n.questDone){
    const bob = Math.sin(performance.now()/300)*2;
    ctx.font = 'bold 12px sans-serif'; ctx.fillStyle = '#ffd54a';
    ctx.fillText('!', Math.round(n.x-2), Math.round(n.y-42+bob));
  }
  if(!n.greetedToday){
    const bob = Math.sin(performance.now()/400)*1.5;
    ctx.font = 'bold 8px sans-serif'; ctx.fillStyle = '#a8d8ff';
    ctx.fillText('☺', Math.round(n.x+8), Math.round(n.y-42+bob));
  }
}
function drawMonster(m){
  const sp = S[m.sprite] || S['m_slime'];
  const w = sp.width, h = sp.height;
  ctx.drawImage(S['shadow'], Math.round(m.x-w/2-2), Math.round(m.y-4));
  if(m.hitTimer>0 && Math.floor(performance.now()/60)%2) ctx.globalAlpha = 0.5;
  if(m.dir<0){
    ctx.save(); ctx.translate(Math.round(m.x)+w/2, 0); ctx.scale(-1,1); ctx.translate(-(Math.round(m.x)+w/2), 0);
    ctx.drawImage(sp, Math.round(m.x-w/2), Math.round(m.y-h)); ctx.restore();
  } else ctx.drawImage(sp, Math.round(m.x-w/2), Math.round(m.y-h));
  ctx.globalAlpha = 1;
  if(m.hp<m.maxHp){
    const bw = 20, bx = Math.round(m.x-bw/2), by = Math.round(m.y-h)-6;
    ctx.fillStyle = '#000'; ctx.fillRect(bx,by,bw,3);
    ctx.fillStyle = '#c04030'; ctx.fillRect(bx+1,by+1,(bw-2)*(m.hp/m.maxHp),1);
  }
}

function drawWorld(){
  const dn = Game.dayNight;
  let skyTop = '#7ec4e8', skyBot = '#c8e0f0';
  if(Game.map==='mine'){ skyTop = '#1a1520'; skyBot = '#2a2028'; }
  else if(Game.map==='farmhouse' || Game.map.indexOf('interior')>=0){ skyTop = '#3a2a1a'; skyBot = '#4a3a2a'; }
  else if(Game.season===2){ skyTop = '#c89a60'; skyBot = '#e8c890'; }
  else if(Game.season===3){ skyTop = '#a8b8c8'; skyBot = '#d8e0e8'; }
  if(dn>0 && Game.map!=='mine' && Game.map!=='farmhouse'){
    skyTop = 'rgb('+Math.round(126*(1-dn)+20*dn)+','+Math.round(196*(1-dn)+20*dn)+','+Math.round(232*(1-dn)+50*dn)+')';
    skyBot = 'rgb('+Math.round(200*(1-dn)+15*dn)+','+Math.round(220*(1-dn)+15*dn)+','+Math.round(240*(1-dn)+30*dn)+')';
  }
  const grad = ctx.createLinearGradient(0,0,0,LH);
  grad.addColorStop(0, skyTop); grad.addColorStop(0.7, skyBot); grad.addColorStop(1, skyBot);
  ctx.fillStyle = grad; ctx.fillRect(0,0,LW,LH);

  if(Game.map!=='mine' && Game.map!=='farmhouse' && Game.map.indexOf('interior')<0){
    const dayT = (Game.time - 6*60) / (20*60);
    const sunAngle = Math.PI * Math.max(0, Math.min(1, dayT));
    const sunX = LW * (0.1 + 0.8 * (1 - Math.cos(sunAngle))/2);
    const sunY = LH * 0.55 - Math.sin(sunAngle) * LH * 0.4;
    const isNight = Game.time >= 20*60 || Game.time < 6*60;
    if(dn > 0.4){
      for(let i=0;i<60;i++){
        const sx = ((i*137+12345) % 997) / 997 * LW;
        const sy = ((i*73+12345) % 397) / 397 * LH * 0.6;
        const twinkle = 0.5 + 0.5*Math.sin(performance.now()/800 + i);
        ctx.fillStyle = 'rgba(255,255,255,' + (dn * 0.7 * twinkle) + ')';
        ctx.fillRect(sx, sy, 1, 1);
      }
    }
    if(!isNight){
      ctx.fillStyle = '#fff0a0';
      ctx.beginPath(); ctx.arc(sunX, sunY, 12, 0, Math.PI*2); ctx.fill();
    } else {
      ctx.fillStyle = '#e8e8f0';
      ctx.beginPath(); ctx.arc(sunX, sunY, 9, 0, Math.PI*2); ctx.fill();
    }
  }

  ctx.save();
  ctx.translate(-Math.round(camera.x), -Math.round(camera.y));
  const m = currentMap();
  if(!m.tiles || !m.tiles.length){ ctx.restore(); return; }
  const startX = Math.max(0, Math.floor(camera.x/TILE));
  const endX = Math.min(m.w-1, Math.ceil((camera.x+LW)/TILE));
  const startY = Math.max(0, Math.floor(camera.y/TILE));
  const endY = Math.min(m.h-1, Math.ceil((camera.y+LH)/TILE));
  for(let y=startY;y<=endY;y++) for(let x=startX;x<=endX;x++) drawTile(m.tiles[y][x], x*TILE, y*TILE);

  if(Game.map==='mine'){
    if(m.stairsUp) ctx.drawImage(S['stairs_up'], m.stairsUp.x*TILE, m.stairsUp.y*TILE);
    if(m.ladder) ctx.drawImage(S['ladder_down'], m.ladder.x*TILE, m.ladder.y*TILE);
    if(m.elevator) ctx.drawImage(S['elevator'], m.elevator.x*TILE-2, m.elevator.y*TILE-8);
  }

  if(Game.map==='farm'){
    const ha = World.farm.houseArea;
    ctx.drawImage(S['house'], ha.x*TILE, ha.y*TILE);
    const sp = World.farm.shopPos;
    ctx.drawImage(S['shop'], sp.x*TILE, sp.y*TILE);
    const st = World.farm.stablePos;
    ctx.drawImage(S['stable'], st.x*TILE, st.y*TILE);
    const cp = World.farm.carpenterPos;
    ctx.drawImage(S['carpenter'], cp.x*TILE, cp.y*TILE);
    for(const bb of Game.builtBuildings){
      const s = S[bb.type] || S['cabin'];
      if(s) ctx.drawImage(s, bb.x*TILE, bb.y*TILE);
    }
    const hd = World.farm.houseDoor;
    ctx.fillStyle = 'rgba(0,0,0,0.6)'; ctx.fillRect(hd.x*TILE+3, hd.y*TILE-6, TILE-6, 8);
    ctx.fillStyle = '#e8c060'; ctx.fillRect(hd.x*TILE+6, hd.y*TILE-4, 4, 6);
    const sd = World.farm.shopDoor;
    ctx.fillStyle = 'rgba(0,0,0,0.6)'; ctx.fillRect(sd.x*TILE+3, sd.y*TILE-6, TILE-6, 8);
    ctx.fillStyle = '#e8c060'; ctx.fillRect(sd.x*TILE+6, sd.y*TILE-4, 4, 6);
  }
  if(Game.map==='town' && World.town.buildings){
    for(const b of World.town.buildings){
      const sp = S[b.type];
      if(sp) ctx.drawImage(sp, b.x*TILE, b.y*TILE);
      if(b.door){
        ctx.fillStyle = 'rgba(0,0,0,0.6)';
        ctx.fillRect(b.door.x*TILE+3, b.door.y*TILE-6, TILE-6, 8);
        ctx.fillStyle = '#e8c060';
        ctx.fillRect(b.door.x*TILE+6, b.door.y*TILE-4, 4, 6);
      }
    }
  }
  if(Game.map==='museum_interior'){
    let idx = 0;
    for(const item of MUSEUM_ITEMS){
      const col = idx % 10, row = Math.floor(idx / 10);
      const px = (2+col)*TILE, py = (2+row*3)*TILE;
      ctx.drawImage(S['museum_pedestal'], px, py);
      if(Game.museumDonations[item.id]){
        ctx.fillStyle = '#e8c060';
        ctx.beginPath(); ctx.arc(px+12, py+8, 5, 0, Math.PI*2); ctx.fill();
      }
      idx++;
    }
  }
  if(Game.map==='house_interior' && Game.houseOwner){
    const b = World.town.buildings.find(x=>x.name === Game.houseOwner);
    if(b && b.residents){
      const isEvening = Game.time >= 18*60 || Game.time < 8*60;
      if(isEvening){
        const positions = [[3,5],[6,5],[9,5],[3,3],[6,3],[9,3]];
        let i = 0;
        for(const id of b.residents){
          const npc = NPC_DATA.find(n=>n.id===id);
          if(!npc) continue;
          const idx = NPC_DATA.indexOf(npc);
          const sp = S['npc'+idx+'_d'];
          const pos = positions[i] || [3,5];
          if(sp) ctx.drawImage(sp, pos[0]*TILE, pos[1]*TILE);
          i++;
        }
      }
    }
  }

  if(player.targetX!==null && !Game.dialogue){
    const tp = performance.now()/400;
    const pulse = 0.6+0.4*Math.sin(tp*Math.PI*2);
    ctx.strokeStyle = 'rgba(255,220,80,'+(0.5+pulse*0.4)+')';
    ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.arc(player.targetX, player.targetY, 4+pulse*2, 0, Math.PI*2); ctx.stroke();
  }

  const items = [];
  const camL = camera.x - 64, camR = camera.x + LW + 64;
  const camT = camera.y - 100, camB = camera.y + LH + 64;
  if(m.objects) for(const o of m.objects){
    if(o.x < camL || o.x > camR || o.y < camT || o.y > camB) continue;
    items.push({y:o.sortY||o.y, draw:()=>drawObject(o)});
  }
  if(Game.map==='farm') for(const a of World.farm.animals){
    if(a.mounted) continue;
    if(a.x < camL || a.x > camR || a.y < camT || a.y > camB) continue;
    items.push({y:a.y, draw:()=>drawAnimal(a)});
  }
  for(const n of NPC_DATA){
    if(n.loc!==Game.map) continue;
    if(n.x < camL || n.x > camR || n.y < camT || n.y > camB) continue;
    items.push({y:n.y, draw:()=>drawNPC(n)});
  }
  if(Game.map==='mine') for(const mon of Game.monsters){
    if(mon.x < camL || mon.x > camR || mon.y < camT || mon.y > camB) continue;
    items.push({y:mon.y, draw:()=>drawMonster(mon)});
  }
  items.push({y:player.y+32, draw:drawPlayer});
  items.sort((a,b)=>a.y-b.y);
  for(const it of items) it.draw();

  if(Game.fishing){
    const px = player.x+12, py = player.y+16;
    let fx = px, fy = py;
    if(player.dir==='d') fy += TILE*2; else if(player.dir==='u') fy -= TILE*2;
    else if(player.dir==='l') fx -= TILE*2; else fx += TILE*2;
    ctx.strokeStyle = '#f0f0f0'; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(px+6, py-6); ctx.lineTo(fx, fy); ctx.stroke();
    const bob = Math.sin(performance.now()/200)*1.5;
    ctx.drawImage(S['bobber'], fx-3, fy-3+bob);
  }
  for(const p of Game.particles){
    ctx.globalAlpha = p.life/p.max;
    ctx.fillStyle = p.color;
    ctx.fillRect(p.x-1, p.y-1, 3, 3);
  }
  ctx.globalAlpha = 1;
  ctx.restore();

  if(dn>0 && Game.map!=='farmhouse' && Game.map.indexOf('interior')<0){ ctx.fillStyle = 'rgba(10,10,30,'+(dn*0.5)+')'; ctx.fillRect(0,0,LW,LH); }
  if(Game.weather==='rain' && Game.map.indexOf('interior')<0 && Game.map!=='mine'){
    ctx.fillStyle = 'rgba(80,80,120,0.15)'; ctx.fillRect(0,0,LW,LH);
    for(let i=0;i<50;i++){
      const rx = (i*53+performance.now()*0.3)%LW;
      const ry = (i*37+performance.now()*0.6)%LH;
      ctx.fillStyle = 'rgba(180,200,255,0.5)';
      ctx.fillRect(rx, ry, 1, 4);
    }
  }
  if(Game.weather==='snow'){
    ctx.fillStyle = 'rgba(220,230,240,0.1)'; ctx.fillRect(0,0,LW,LH);
    for(let i=0;i<40;i++){
      const rx = (i*53+performance.now()*0.05)%LW;
      const ry = (i*37+performance.now()*0.15)%LH;
      ctx.fillStyle = 'rgba(255,255,255,0.7)';
      ctx.fillRect(rx, ry, 2, 2);
    }
  }
  if(Game.weather==='fog'){ ctx.fillStyle = 'rgba(220,220,230,0.25)'; ctx.fillRect(0,0,LW,LH); }
  const vg = ctx.createRadialGradient(LW/2,LH/2,LH*0.4,LW/2,LH/2,LH*0.9);
  vg.addColorStop(0,'rgba(0,0,0,0)');
  vg.addColorStop(1,'rgba(0,0,0,0.28)');
  ctx.fillStyle = vg; ctx.fillRect(0,0,LW,LH);
}

function drawHUD(){
  // Top-left panels
  ctx.fillStyle = 'rgba(20,15,10,0.85)'; ctx.fillRect(6,6,116,44);
  ctx.strokeStyle = '#8a5a2a'; ctx.lineWidth = 1; ctx.strokeRect(6.5,6.5,115,43);
  ctx.fillStyle = '#e8c060'; ctx.font = 'bold 9px monospace';
  const h = Math.floor(Game.time/60)%24, mn = Math.floor(Game.time%60);
