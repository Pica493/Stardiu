function startAction(ac){ player.action = ac; player.actionTimer = 400; }
function removeObject(o){ const m = currentMap(); if(!m.objects) return; const i = m.objects.indexOf(o); if(i>=0) m.objects.splice(i,1); }
function spawnParticle(x,y,c){ if(Game.particles.length > 60) return; for(let i=0;i<5;i++) Game.particles.push({x:x+(Math.random()-.5)*8, y:y+(Math.random()-.5)*4, vx:(Math.random()-.5)*2, vy:-Math.random()*1.5, life:600, max:600, color:c}); }
function consumeEnergy(n){ Game.energy = Math.max(0, Game.energy-n); }
function toolPower(t2){ return TOOL_LEVELS[Game.toolLevels[t2]||0].mult; }

function attack(tx,ty){
  const weapon = WEAPONS[Game.weaponLevel];
  const mon = findMonsterAt(tx,ty);
  if(!mon) return false;
  startAction('use'); Snd.play('hit');
  const isCrit = Math.random() < weapon.crit;
  const dmg = Math.floor(weapon.dmg * (isCrit?2:1));
  mon.hp -= dmg; mon.hitTimer = 200;
  spawnParticle(mon.x, mon.y-8, isCrit?'#ffff40':'#ff4040');
  if(mon.hp<=0){
    const t2 = MONSTER_TYPES.find(x=>x.id===mon.typeId);
    if(t2){ if(Math.random()<t2.drop[1]) Game.inv[t2.drop[0]] = (Game.inv[t2.drop[0]]||0)+t2.yield; }
    Game.kills[mon.typeId] = (Game.kills[mon.typeId]||0)+1;
    Game.gold += 2+Math.floor(Math.random()*5);
    addSkill('combat', 5);
    const idx = Game.monsters.indexOf(mon);
    if(idx>=0) Game.monsters.splice(idx,1);
    toast('Killed '+mon.name);
  }
  consumeEnergy(1);
  return true;
}

function useItem(itemId){
  const c = CONSUMABLES[itemId];
  if(!c) return false;
  if((Game.inv[itemId]||0) <= 0) return false;
  if(Game.hp >= Game.maxHp && Game.energy >= Game.maxEnergy) { toast('Already full'); return false; }
  Game.inv[itemId]--;
  if(c.hp) Game.hp = Math.min(Game.maxHp, Game.hp + c.hp);
  if(c.en) Game.energy = Math.min(Game.maxEnergy, Game.energy + c.en);
  toast('Used '+itemId+' '+(c.hp?'+'+c.hp+'HP ':'')+(c.en?'+'+c.en+'⚡':''));
  Snd.play('eat');
  return true;
}

function doActionAt(tx,ty){
  if(player.action || Game.sleeping || Game.dialogue || Game.menuOpen) return;

  // MINE
  if(Game.map==='mine'){
    const m = currentMap();
    if(m.stairsUp && tx===m.stairsUp.x && ty===m.stairsUp.y){
      Snd.play('door');
      if(m.depth<=1){
        fadeTo(()=>{
          Game.map = Game.mineEntry || 'farm';
          if(Game.mineEntry==='mountain'){
            player.x = 24*TILE+8; player.y = 8*TILE;
          } else {
            player.x = World.farm.cavePos.x*TILE+8;
            player.y = (World.farm.cavePos.y+2)*TILE;
          }
        });
      } else {
        fadeTo(()=>{ generateMine(m.depth-1); });
      }
      return;
    }
    if(m.ladder && tx===m.ladder.x && ty===m.ladder.y){
      Snd.play('door');
      fadeTo(()=>{ generateMine(m.depth+1); });
      return;
    }
    if(m.elevator && tx===m.elevator.x && ty===m.elevator.y){
      Snd.play('elevator');
      openElevator();
      return;
    }
  }

  if(Game.map==='farm'){
    const hd = World.farm.houseDoor;
    if(tx===hd.x && ty===hd.y){ enterBuilding('farmhouse','farm'); return; }
    const sd = World.farm.shopDoor;
    if(tx===sd.x && ty===sd.y){ enterBuilding('shop_interior','farm'); return; }
    const stD = World.farm.stableDoor;
    if(tx===stD.x && ty===stD.y){ if(!Game.onHorse) openShop({name:'Stable',role:'Horses',shop:'horses'}); return; }
    const cD = World.farm.carpenterDoor;
    if(tx===cD.x && ty===cD.y){ enterBuilding('blacksmith_interior','farm',()=>openShop({name:'Carpenter',role:'Build',shop:'build'})); return; }
    const cp = World.farm.cavePos;
    if(Math.abs(tx-cp.x)<3 && Math.abs(ty-cp.y)<2){
      Snd.play('door'); Game.mineEntry = 'farm';
      fadeTo(()=>{ Game.map='mine'; generateMine(1); });
      return;
    }
  }

  if(Game.map==='mountain'){
    if(tx>=22 && tx<=26 && ty>=4 && ty<=6){
      Snd.play('door'); Game.mineEntry = 'mountain';
      fadeTo(()=>{ Game.map='mine'; generateMine(1); });
      return;
    }
  }

  if(Game.map==='farmhouse' || Game.map==='house_interior' || Game.map==='shop_interior' || Game.map==='blacksmith_interior' || Game.map==='museum_interior'){
    const m = currentMap();
    const exitX = Math.floor(m.w/2);
    if(ty >= m.h-1 && (tx===exitX || tx===exitX+1)){ exitBuilding(Game.prevMap || 'farm', Game.map); return; }
    // Bed interaction: sleep
    if(Game.map==='farmhouse'){
      const bed = findObjectAt(tx,ty);
      if(bed && bed.type==='bed'){ startSleep(); return; }
    }
  }
  if(Game.map==='town' && World.town.buildings){
    for(const b of World.town.buildings){
      if(b.door && tx===b.door.x && ty===b.door.y){
        if(b.type==='museum'){ enterBuilding('museum_interior','town'); return; }
        if(b.type==='shop'){ openShop({name:'General Store',role:'Goods',shop:'seeds'}); return; }
        if(b.type==='blacksmith'){ openShop({name:'Blacksmith',role:'Weapons',shop:'weapons'}); return; }
        if(b.type==='tavern'){ openShop({name:'Tavern',role:'Drinks',shop:'drinks'}); return; }
        if(b.type==='carpenter'){ openShop({name:'Carpenter',role:'Build',shop:'build'}); return; }
        if(b.residents && b.residents.length){ enterBuilding('house_interior','town',null, b.name); return; }
        if(b.type==='townhall'){ toast('Town Hall'); Snd.play('door'); return; }
      }
    }
  }

  const mon = findMonsterAt(tx,ty);
  if(mon){ attack(tx,ty); return; }
  if(Game.map==='farm'){
    const an = World.farm.animals.find(a=>Math.abs(a.x-(tx*TILE+8))<14 && Math.abs(a.y-(ty*TILE+16))<14);
    if(an){ collectAnimal(an); return; }
  }
  const npc = findNPCAt(tx,ty);
  if(npc){ startDialogue(npc); return; }

  const tool = Game.hotbar[Game.selected];
  const t2 = tileAt(tx,ty);
  const obj = findObjectAt(tx,ty);

  if(obj && obj.type==='crop' && obj.stage===4){
    Game.inv[obj.cropType] = (Game.inv[obj.cropType]||0)+1;
    toast('+1 '+obj.cropType); Snd.play('harvest'); removeObject(obj);
    addSkill('farming', 5); startAction('use'); consumeEnergy(1); return;
  }
  if(tool==='axe'){
    if(obj && (obj.type==='tree'||obj.type==='pine')){
      startAction('use'); obj.hp -= Math.floor(toolPower('axe')); Snd.play('chop');
      spawnParticle(obj.x,obj.y-20,'#8a5a30'); consumeEnergy(2);
      if(obj.hp<=0){ const n = 3+Math.floor(Math.random()*3); Game.inv.wood += n; toast('+'+n+' 🪵'); removeObject(obj); addSkill('foraging', 5); }
      return;
    }
    Snd.play('error'); return;
  }
  if(tool==='pick'){
    if(obj && (obj.type==='rock_s'||obj.type==='rock_m'||obj.type==='rock_l'||obj.type==='rock_small')){
      startAction('use'); obj.hp = (obj.hp||2)-Math.floor(toolPower('pick')); Snd.play('pick');
      spawnParticle(obj.x,obj.y-8,'#a0a0a8'); consumeEnergy(2);
      if(obj.hp<=0){ const n = 2+Math.floor(Math.random()*3); Game.inv.stone += n; toast('+'+n+' 🪨'); removeObject(obj); addSkill('mining', 5); }
      return;
    }
    if(t2===T_CU||t2===T_IR||t2===T_GO||t2===T_IRID){
      startAction('use'); Snd.play('pick'); consumeEnergy(2);
      let ore = 'copper', cnt = 1+Math.floor(Math.random()*2);
      if(t2===T_IR) ore='iron'; else if(t2===T_GO) ore='gold_ore'; else if(t2===T_IRID) ore='iri';
      Game.inv[ore] = (Game.inv[ore]||0)+cnt;
      currentMap().tiles[ty][tx] = T_CAVE;
      addSkill('mining', 5); toast('+'+cnt+' '+ore);
      return;
    }
    Snd.play('error'); return;
  }
  if(tool==='hoe'){
    if(t2===T_GRASS){ currentMap().tiles[ty][tx] = T_TILL; startAction('use'); consumeEnergy(2); return; }
    return;
  }
  if(tool==='can'){
    if(t2===T_TILL){ currentMap().tiles[ty][tx] = T_TILL_WET; startAction('use'); Snd.play('water'); consumeEnergy(1); return; }
    return;
  }
  if(tool==='seed'){
    if(Game.inv.seeds<=0){ Snd.play('error'); toast('No seeds'); return; }
    if(t2===T_TILL||t2===T_TILL_WET){
      if(findObjectAt(tx,ty)){ Snd.play('error'); toast('Already planted'); return; }
      Game.inv.seeds--; consumeEnergy(1);
      const type = CROPS[Math.floor(Math.random()*CROPS.length)];
      currentMap().objects.push({type:'crop',cropType:type,x:tx*TILE+8,y:(ty+1)*TILE,tx,ty,stage:0,watered:false,solid:false,sortY:(ty+1)*TILE});
      startAction('use'); Snd.play('plant'); return;
    }
    return;
  }
  if(tool==='rod'){
    if(t2===T_WATER||t2===T_DEEP){ startFishing(); return; }
    Snd.play('error'); toast('Stand by water'); return;
  }
}

function startFishing(){ Game.fishing = {timer:0, duration:2500, caught:false}; startAction('use'); }
function getFishingResult(){
  const hour = Math.floor(Game.time/60)%24;
  const time = (hour<20&&hour>=6)?'day':'night';
  // Use tile under player's facing tile as target
  const fx = player.x+12 + (player.dir==='l'?-24:player.dir==='r'?24:0);
  const fy = player.y+24 + (player.dir==='u'?-24:player.dir==='d'?24:0);
  const targetTile = tileAt(Math.floor(fx/TILE), Math.floor(fy/TILE));
  const isDeep = targetTile === T_DEEP;
  const loc = Game.map==='beach' ? (isDeep?'deep':'beach') : 'farm';
  let pool = FISH_LIST.filter(f=>(f.loc===loc||(f.loc==='beach'&&loc==='deep')) && (f.time===time||f.time==='any'));
  if(!pool.length) pool = FISH_LIST.filter(f=>f.loc==='beach');
  let total = 0; for(const f of pool) total += f.chance;
  let r = Math.random()*total;
  for(const f of pool){ r -= f.chance; if(r<=0) return f; }
  return pool[0];
}
function collectAnimal(a){
  startAction('use');
  if(a.growthStage<1){ toast('Still young'); return; }
  if(a.type==='horse'){ toggleHorse(a); return; }
  if(a.produceReady){
    const type = ANIMAL_TYPES[a.type];
    Game.inv[type.product] = (Game.inv[type.product]||0)+1;
    a.produceReady = false; a.produceTimer = type.time;
    toast(type.icon+' +1 '+type.product);
    Snd.play(a.type==='chicken'||a.type==='duck'?'cluck':'moo');
    addSkill('farming', 3);
  } else Snd.play(a.type==='chicken'||a.type==='duck'?'cluck':'moo');
}
function toggleHorse(horse){
  if(Game.onHorse){
    Game.onHorse = false;
    if(horse){ horse.mounted = false; player.x = horse.x-8; player.y = horse.y; }
    toast('Dismounted'); Snd.play('neigh');
  } else {
    if(!horse) horse = World.farm.animals.find(a=>a.type==='horse'&&a.growthStage>=1);
    if(!horse){ toast('No horse'); return; }
    const d = Math.hypot(player.x-horse.x, player.y-horse.y);
    if(d<60){ Game.onHorse = true; horse.mounted = true; toast('Mounted!'); Snd.play('neigh'); }
    else toast('Get closer');
  }
}

