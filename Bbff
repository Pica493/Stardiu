function renderShopMenu(npc){
  const box = $('menuContent'); box.innerHTML = '';
  const h = document.createElement('h3'); h.textContent = npc.name+' — '+npc.role; box.appendChild(h);
  const goldEl = document.createElement('div');
  goldEl.style.cssText = 'color:#e8c060;font-size:13px;text-align:center;margin-bottom:6px';
  goldEl.textContent = '🪙 '+Game.gold;
  box.appendChild(goldEl);
  const grid = document.createElement('div'); grid.className = 'inv-grid';
  function addRow(name, price, action, sell){
    const it = document.createElement('div'); it.className = 'inv-item';
    it.innerHTML = '<span>'+name+'</span><span class="count">'+(sell?'+':'')+price+'</span>';
    const btn = document.createElement('button');
    btn.textContent = sell?'Sell':'Buy';
    btn.onclick = ()=>{
      if(sell){ if(action()){ Snd.play('coin'); renderShopMenu(npc); } else Snd.play('error'); }
      else if(Game.gold>=price){ Game.gold -= price; try{ action(); }catch(e){ Game.gold += price; Snd.play('error'); return; } Snd.play('coin'); renderShopMenu(npc); }
      else { Snd.play('error'); toast('Not enough gold'); }
    };
    it.appendChild(btn); grid.appendChild(it);
  }
  switch(npc.shop){
    case 'seeds': addRow('🌱 Seeds ×5', 20, ()=>Game.inv.seeds+=5); break;
    case 'animals':
      for(const k of ['chicken','duck','rabbit','pig','cow','goat']){
        const at = ANIMAL_TYPES[k];
        addRow(at.name, at.price, ()=>spawnAnimal(k));
      }
      break;
    case 'horses': addRow('🐴 Horse', ANIMAL_TYPES.horse.price, ()=>spawnAnimal('horse')); break;
    case 'weapons':
      for(let i=1;i<WEAPONS.length;i++){
        const w = WEAPONS[i];
        addRow('⚔ '+w.name+' (dmg '+w.dmg+')', w.price, ()=>{ if(Game.weaponLevel<i) Game.weaponLevel=i; });
      }
      for(const tool of ['axe','pick','hoe','can','rod']){
        const next = (Game.toolLevels[tool]||0)+1;
        if(next<TOOL_LEVELS.length){
          const tl = TOOL_LEVELS[next];
          addRow('🔨 '+toolName(tool)+' → '+tl.name, tl.price, ()=>{
            if((Game.inv[tl.resource]||0) >= tl.count){
              Game.inv[tl.resource] -= tl.count;
              Game.toolLevels[tool] = next;
              toast(toolName(tool)+' upgraded!');
            } else { toast('Need '+tl.count+' '+tl.resource); throw 0; }
          });
        }
      }
      break;
    case 'ores':
      addRow('Copper ×5', 40, ()=>Game.inv.copper+=5);
      addRow('Iron ×3', 80, ()=>Game.inv.iron+=3);
      addRow('Gold ×2', 150, ()=>Game.inv.gold_ore+=2);
      addRow('Iridium ×1', 300, ()=>Game.inv.iri+=1);
      break;
    case 'build':
      addRow('🏠 Cabin (30🪵)', 500, ()=>{
        if(Game.inv.wood>=30){
          Game.inv.wood -= 30;
          const px = Math.floor(player.x/TILE)+2, py = Math.floor(player.y/TILE);
          Game.builtBuildings.push({type:'cabin',x:px,y:py});
          toast('Built cabin!');
        } else { toast('Need 30 wood'); throw 0; }
      });
      break;
    case 'food': addRow('🍞 Bread ×3', 25, ()=>Game.inv.food+=3); break;
    case 'heal':
      addRow('❤ Potion', 60, ()=>Game.inv.potion=(Game.inv.potion||0)+1);
      addRow('💊 Full heal', 100, ()=>{ Game.hp = Game.maxHp; });
      break;
    case 'drinks': addRow('🍺 Ale', 20, ()=>Game.inv.food+=1); break;
    case 'exotic': addRow('🌱 Rare seeds ×3', 90, ()=>Game.inv.seeds+=3); break;
    case 'fish': addRow('Sell all fish', 15, ()=>{ let n = Game.inv.fish||0; if(n>0){ Game.gold += n*15; Game.inv.fish = 0; return true; } return false; }, true); break;
  }
  addRow('Sell raw goods', 8, ()=>{
    let sum = 0;
    for(const k of ['wood','stone','copper','iron','gold_ore','iri','fish','egg','milk','wool','slime','bone','feather']){
      if(Game.inv[k]){ sum += Game.inv[k]*8; Game.inv[k] = 0; }
    }
    if(sum>0){ Game.gold += sum; toast('+'+sum+'🪙'); return true; }
    return false;
  }, true);
  const closeBtn = document.createElement('button');
  closeBtn.textContent = '✕ Close Shop';
  closeBtn.style.cssText = 'display:block;margin:12px auto 0;background:#6a2020;border-color:#a04040;padding:10px 24px;touch-action:manipulation;font-family:inherit;color:#ffe8b0;border:3px solid;border-radius:4px;cursor:pointer;font-weight:bold';
  closeBtn.onclick = closeMenu;
  box.appendChild(closeBtn);
  box.appendChild(grid);
}

