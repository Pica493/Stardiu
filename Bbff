  ctx.fillText((h<10?'0':'')+h+':'+(mn<10?'0':'')+mn+'  '+Game.seasonDay+'/7', 10, 30);
  ctx.fillStyle = '#fff'; ctx.fillText('🪙 '+Game.gold, 10, 44);

