  else if(action==='sleep'){if(player.state!=='sleep'){player.state='sleep';player.frameIndex=0;player.frameTimer=0;Audio.play('sleep');}}}

window.addEventListener('keydown',(e)=>{const k=e.key.toLowerCase();keys[k]=true;
  if([' ','arrowup','arrowdown','arrowleft','arrowright'].includes(k))e.preventDefault();
  if(k==='escape'){if(gameState===GS.PLAYING)pauseGame();else if(gameState===GS.PAUSED)resumeGame();return;}
  if(gameState!==GS.PLAYING)return;
  if(k===' ')triggerAction('attack');else if(k==='e')triggerAction('useItem');else if(k==='z')triggerAction('sleep');});
window.addEventListener('keyup',(e)=>{keys[e.key.toLowerCase()]=false;});

// ============================================================
// УПРАВЛЕНИЕ МЫШЬЮ / ПАЛЬЦЕМ — Stardew style
// ============================================================
function screenToWorld(clientX, clientY){
  const rect=canvas.getBoundingClientRect();
  // Координаты внутри canvas в пикселях canvas (800x600)
  const sx=(clientX-rect.left)*(canvas.width/rect.width);
  const sy=(clientY-rect.top)*(canvas.height/rect.height);
  // Переводим в логические координаты (400x300)
  const lx=sx/SCALE, ly=sy/SCALE;
  // Прибавляем камеру — получаем мировые координаты
  return {x:lx+camera.x, y:ly+camera.y};
}

let pointerDown=false;
function onPointerDown(e){
  if(gameState!==GS.PLAYING)return;
  if(e.target!==canvas)return;
  e.preventDefault();
  pointerDown=true;
  const p=screenToWorld(e.clientX, e.clientY);
  player.targetX=p.x;
  player.targetY=p.y;
}
function onPointerMove(e){
  if(!pointerDown)return;
  if(gameState!==GS.PLAYING)return;
  if(e.target!==canvas && !canvas.hasPointerCapture(e.pointerId))return;
  const p=screenToWorld(e.clientX, e.clientY);
  player.targetX=p.x;
  player.targetY=p.y;
}
function onPointerUp(e){
  pointerDown=false;
}
canvas.addEventListener('pointerdown', onPointerDown);
canvas.addEventListener('pointermove', onPointerMove);
window.addEventListener('pointerup', onPointerUp);
window.addEventListener('pointercancel', onPointerUp);

// ============================================================
// TOUCH CONTROLS (D-pad)
// ============================================================
let touchSetup=false;
function setupTouchControls(){if(touchSetup)return;
  const isTouch=('ontouchstart' in window)||navigator.maxTouchPoints>0;if(!isTouch)return;touchSetup=true;
  const c=$('touchControls');c.classList.add('active');
  const defs=[{key:'arrowup',label:'▲',cls:'tc-dpad-up'},{key:'arrowdown',label:'▼',cls:'tc-dpad-down'},
    {key:'arrowleft',label:'◀',cls:'tc-dpad-left'},{key:'arrowright',label:'▶',cls:'tc-dpad-right'},
    {action:'attack',label:'A',cls:'tc-atk'},{action:'useItem',label:'E',cls:'tc-item'},{action:'sleep',label:'Z',cls:'tc-sleep'}];
  defs.forEach(d=>{const el=document.createElement('div');el.className='tc-btn '+d.cls;el.textContent=d.label;
    const onStart=(e)=>{e.preventDefault();e.stopPropagation();el.classList.add('pressed');
      if(d.key){keys[d.key]=true;player.targetX=null;player.targetY=null;}
      if(d.action)triggerAction(d.action);};
    const onEnd=(e)=>{e.preventDefault();e.stopPropagation();el.classList.remove('pressed');
      if(d.key)keys[d.key]=false;};
    el.addEventListener('touchstart',onStart,{passive:false});
    el.addEventListener('touchend',onEnd,{passive:false});
    el.addEventListener('touchcancel',onEnd,{passive:false});
    el.addEventListener('mousedown',onStart);
    el.addEventListener('mouseup',onEnd);el.addEventListener('mouseleave',onEnd);
    c.appendChild(el);});}
setupTouchControls();

// ============================================================
// КОЛЛИЗИИ
// ============================================================
function isSolidAt(px,py){const col=Math.floor(px/32),row=Math.floor(py/32);
  if(col<0||col>=MAP_COLS||row<0||row>=MAP_ROWS)return true;
  return SOLID_TILES.includes(mapData[row][col]);}
function checkCollision(nx,ny){const pX=8,pT=18,pB=4;
  return isSolidAt(nx+pX,ny+pT)||isSolidAt(nx+32-pX,ny+pT)||
         isSolidAt(nx+pX,ny+32-pB)||isSolidAt(nx+32-pX,ny+32-pB);}

// ============================================================
// UPDATE
// ============================================================
function update(dt){
  if(gameState!==GS.PLAYING)return;

  // Сон
  if(player.state==='sleep'){
    const moving=keys['w']||keys['a']||keys['s']||keys['d']||
                 keys['arrowup']||keys['arrowleft']||keys['arrowdown']||keys['arrowright'];
    if(moving){player.state='idle';player.frameIndex=0;player.frameTimer=0;}
    else{player.frameTimer+=dt;const cfg=animConfig.sleep;
      if(player.frameTimer>cfg.speed){player.frameTimer=0;
        player.frameIndex=(player.frameIndex+1)%cfg.frames;
        if(player.frameIndex===0)Audio.play('sleep');}return;}}

  // Атака / предмет
  if(player.state==='attack'||player.state==='useItem'){
    player.frameTimer+=dt;const cfg=animConfig[player.state];
    if(player.frameTimer>cfg.speed){player.frameTimer=0;player.frameIndex++;
      if(player.frameIndex>=cfg.frames){player.state='idle';player.frameIndex=0;player.frameTimer=0;}}
    return;}

  // === ВВОД ===
  let dx=0,dy=0;
  if(keys['w']||keys['arrowup'])    {dy=-1;player.direction='up';}
  if(keys['s']||keys['arrowdown'])  {dy=1;player.direction='down';}
  if(keys['a']||keys['arrowleft'])  {dx=-1;player.direction='left';}
  if(keys['d']||keys['arrowright']) {dx=1;player.direction='right';}

  // Если есть ввод с клавиатуры — отменяем цель
  if(dx!==0||dy!==0){
    player.targetX=null;player.targetY=null;
  }

  // Клик/тап на мире — движение к цели
  if(dx===0 && dy===0 && player.targetX!==null){
    const cx=player.x+16, cy=player.y+16;
    const tdx=player.targetX-cx, tdy=player.targetY-cy;
    const dist=Math.sqrt(tdx*tdx+tdy*tdy);
    if(dist<4){
      // Дошли
      player.targetX=null;player.targetY=null;
    } else {
      dx=tdx/dist;
      dy=tdy/dist;
      // Направление по большей оси
      if(Math.abs(tdx)>Math.abs(tdy)){
        player.direction=tdx>0?'right':'left';
      } else {
        player.direction=tdy>0?'down':'up';
      }
    }
  }

  // Нормализация диагонали (только для клавиатуры, у цели вектор уже единичный)
  if(dx!==0 && dy!==0 && (dx*dx+dy*dy)>1.1){
    dx*=0.7071; dy*=0.7071;
  }

  player.isMoving=(dx!==0||dy!==0);
  player.vx=dx*player.speed;
  player.vy=dy*player.speed;

  // Движение с коллизиями
  let blockedX=false, blockedY=false;
  if(player.vx!==0){
    const nx=player.x+player.vx;
    if(!checkCollision(nx,player.y)) player.x=nx;
    else blockedX=true;
  }
  if(player.vy!==0){
    const ny=player.y+player.vy;
    if(!checkCollision(player.x,ny)) player.y=ny;
    else blockedY=true;
  }

  // Если у цели — и упёрлись в стену — сброс цели
  if(player.targetX!==null && blockedX && blockedY){
    player.targetX=null;
    player.targetY=null;
  }

  // === АНИМАЦИЯ ===
  let animState='idle';
  if(player.isMoving)animState='walk'+player.direction.charAt(0).toUpperCase()+player.direction.slice(1);
  if(player.state!==animState){
    player.state=animState;player.frameIndex=0;player.frameTimer=0;player.lastStepFrame=-1;
  }
  player.frameTimer+=dt;
  const cfg=animConfig[player.state];
  if(player.frameTimer>cfg.speed){
    player.frameTimer=0;const prev=player.frameIndex;
    if(cfg.loop)player.frameIndex=(player.frameIndex+1)%cfg.frames;
    else if(player.frameIndex<cfg.frames-1)player.frameIndex++;
    if(cfg.stepFrames&&cfg.stepFrames.includes(player.frameIndex)&&
       player.frameIndex!==prev&&player.isMoving)Audio.play('step');
  }

  // Камера
  camera.x=player.x-WIDTH/2+16;
  camera.y=player.y-HEIGHT/2+16;
  camera.x=Math.max(0,Math.min(camera.x,MAP_COLS*32-WIDTH));
  camera.y=Math.max(0,Math.min(camera.y,MAP_ROWS*32-HEIGHT));
}

// ============================================================
// DRAW
// ============================================================
function draw(){
  ctx.setTransform(1,0,0,1,0,0);ctx.fillStyle='#0a1a0a';ctx.fillRect(0,0,canvas.width,canvas.height);
  ctx.setTransform(SCALE,0,0,SCALE,0,0);
  ctx.save();ctx.translate(-Math.round(camera.x),-Math.round(camera.y));

  // === Тайлы ===
  const tilesImg=getTilesImg();
  const tg=getTilesGrid();
  const startCol=Math.max(0,Math.floor(camera.x/32));
  const endCol=Math.min(MAP_COLS-1,Math.ceil((camera.x+WIDTH)/32));
  const startRow=Math.max(0,Math.floor(camera.y/32));
  const endRow=Math.min(MAP_ROWS-1,Math.ceil((camera.y+HEIGHT)/32));
  for(let row=startRow;row<=endRow;row++)for(let col=startCol;col<=endCol;col++){
    const idx=mapData[row][col];const dx=col*32,dy=row*32;
    const tCol=idx%TILESET_COLS,tRow=Math.floor(idx/TILESET_COLS);
    const sx=tg.ox+tCol*tg.cell, sy=tg.oy+tRow*tg.cell;
    try{ctx.drawImage(tilesImg,sx,sy,tg.cell,tg.cell,dx,dy,32,32);}
    catch(e){ctx.fillStyle='#4a8c3a';ctx.fillRect(dx,dy,32,32);}
  }

  // === Маркер цели ===
  if(player.targetX!==null){
    const t=performance.now()/400;
    const pulse=0.6+0.4*Math.sin(t*Math.PI*2);
    const r=5+pulse*3;
    // Внешнее кольцо
    ctx.strokeStyle='rgba(255,220,80,'+(0.4+pulse*0.4)+')';
    ctx.lineWidth=1.5;
    ctx.beginPath();
    ctx.arc(player.targetX, player.targetY, r+3, 0, Math.PI*2);
    ctx.stroke();
    // Внутренняя точка
    ctx.fillStyle='rgba(255,220,80,'+(0.7+pulse*0.3)+')';
    ctx.beginPath();
    ctx.arc(player.targetX, player.targetY, 2.5, 0, Math.PI*2);
    ctx.fill();
  }

  // === Тень игрока ===
  ctx.fillStyle='rgba(0,0,0,0.25)';ctx.beginPath();
  ctx.ellipse(player.x+16,player.y+30,12,4,0,0,Math.PI*2);ctx.fill();

  // === Игрок ===
  const charImg=getCharImg();
  const cg=getCharGrid();
  const cfg=animConfig[player.state]||animConfig.idle;
  const sx=cg.ox+player.frameIndex*cg.cell;
  const sy=cg.oy+Math.floor(cfg.y/32)*cg.cell;
  try{ctx.drawImage(charImg,sx,sy,cg.cell,cg.cell,
    Math.round(player.x),Math.round(player.y),32,32);}
  catch(e){ctx.fillStyle='#ffd54a';ctx.fillRect(player.x+8,player.y+6,16,12);}

  ctx.restore();

  // HUD
  if(gameState===GS.PLAYING){
    ctx.fillStyle='rgba(0,0,0,0.55)';ctx.fillRect(8,HEIGHT-22,170,16);
    ctx.fillStyle='#8ec96f';ctx.font='11px monospace';ctx.textAlign='left';
    ctx.fillText('State: '+player.state,14,HEIGHT-10);
  }
}

// ============================================================
// GAME LOOP
// ============================================================
let lastTime=performance.now();
function gameLoop(now){let dt=now-lastTime;lastTime=now;
  if(dt>100)dt=100;if(dt<0)dt=0;
  try{update(dt);draw();}catch(e){errorBar.style.display='block';
    errorBar.textContent='Loop Error: '+e.message;}
  requestAnimationFrame(gameLoop);}
showScreen('main');
requestAnimationFrame(gameLoop);
window.addEventListener('blur',()=>{if(gameState===GS.PLAYING)pauseGame();});
document.addEventListener('visibilitychange',()=>{
  if(!document.hidden&&gameState===GS.PLAYING)Audio.resume();});
})();
</script>
