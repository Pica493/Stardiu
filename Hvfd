const Audio={ctx:null,musicGain:null,sfxGain:null,musicTimer:null,musicPlaying:false,musicVol:.4,sfxVol:.7,
  init(){if(this.ctx)return;try{const AC=window.AudioContext||window.webkitAudioContext;if(!AC)return;
