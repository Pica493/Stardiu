<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#0d0d0d">
<title>Pixel Farm</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{width:100%;height:100%;overflow:hidden;background:#0a1a0a;font-family:'Segoe UI',sans-serif;color:#fff;user-select:none;-webkit-user-select:none;touch-action:none;position:fixed}
#canvasWrapper{position:fixed;inset:0;display:flex;justify-content:center;align-items:center;background:#0a1a0a;overflow:hidden}
#gameCanvas{display:block;max-width:100%;max-height:100%;width:auto;height:auto;image-rendering:pixelated;image-rendering:crisp-edges;touch-action:none;box-shadow:0 0 40px rgba(0,0,0,.9);cursor:crosshair}
#touchControls{position:fixed;inset:0;pointer-events:none;z-index:50;display:none}
#touchControls.active{display:block}
.tc-btn{position:absolute;pointer-events:auto;background:rgba(142,201,111,.35);border:2px solid rgba(142,201,111,.75);border-radius:50%;display:flex;justify-content:center;align-items:center;color:#fff;font-weight:bold;user-select:none;transition:all .06s;touch-action:none}
.tc-btn:active,.tc-btn.pressed{background:rgba(142,201,111,.9);transform:scale(.94)}
.tc-dpad-up{bottom:180px;left:70px;width:60px;height:60px;font-size:22px}
.tc-dpad-down{bottom:60px;left:70px;width:60px;height:60px;font-size:22px}
.tc-dpad-left{bottom:120px;left:10px;width:60px;height:60px;font-size:22px}
.tc-dpad-right{bottom:120px;left:130px;width:60px;height:60px;font-size:22px}
.tc-atk{bottom:90px;right:30px;width:80px;height:80px;font-size:18px}
.tc-item{bottom:190px;right:40px;width:60px;height:60px;font-size:14px}
.tc-sleep{bottom:90px;right:130px;width:60px;height:60px;font-size:14px}
.screen{position:fixed;inset:0;display:flex;flex-direction:column;justify-content:center;align-items:center;background:linear-gradient(135deg,#1a2a1a 0%,#0d0d0d 100%);z-index:100;padding:16px;gap:8px;overflow-y:auto}
.screen.hidden{display:none}
.screen h1{font-size:clamp(28px,8vw,56px);letter-spacing:4px;color:#8ec96f;text-shadow:0 4px 0 #1a2a1a,0 8px 20px rgba(142,201,111,.4);margin-bottom:16px;font-family:'Courier New',monospace;text-align:center}
.screen h2{font-size:clamp(20px,5vw,32px);color:#8ec96f;margin-bottom:16px;text-align:center}
.screen button{background:#2a4a2a;color:#d8ffd0;border:2px solid #4a7a4a;padding:12px 28px;font-size:clamp(14px,3.8vw,17px);cursor:pointer;border-radius:6px;font-family:inherit;letter-spacing:1px;transition:all .15s;min-width:200px;max-width:92vw;touch-action:manipulation}
.screen button:hover{background:#3a6a3a;border-color:#8ec96f}
.screen button:active{transform:scale(.97)}
.screen button.danger{background:#4a2020;border-color:#7a3a3a;color:#ffb0b0}
.screen button.primary{background:#4a7a2a;border-color:#8ec96f}
.screen button.small{min-width:100px;padding:8px 16px;font-size:13px}
.slider-row{display:flex;align-items:center;gap:10px;width:min(420px,92vw);padding:6px 0;font-size:13px}
.slider-row label{width:90px;color:#b0d8a0;flex-shrink:0}
.slider-row input[type=range]{flex:1;accent-color:#8ec96f;height:6px}
.slider-row .val{width:46px;text-align:right;color:#8ec96f}
.slot{width:min(440px,92vw);padding:14px 20px;background:#1a2a1a;border:2px solid #3a5a3a;border-radius:6px;cursor:pointer;display:flex;justify-content:space-between;align-items:center;transition:all .15s;gap:10px}
.slot:hover{border-color:#8ec96f;background:#223422}
.slot .info{text-align:left;flex:1}
.slot .name{font-size:15px;color:#d8ffd0}
.slot .date{font-size:11px;color:#7a9a7a;margin-top:4px}
.slot .empty{color:#5a7a5a;font-style:italic}
.slot .actions{display:flex;gap:6px}
.slot .actions button{min-width:auto;padding:6px 10px;font-size:11px}
.row{display:flex;gap:10px;margin-top:14px;flex-wrap:wrap;justify-content:center}
#hud{position:fixed;top:10px;left:10px;background:rgba(0,0,0,.6);padding:8px 12px;border-radius:6px;border:1px solid #3a3a3a;font-size:11px;line-height:1.5;pointer-events:none;display:none;z-index:40}
#hud b{color:#ffd54a}
#errorBar{position:fixed;top:0;left:0;right:0;background:#800;color:#fff;padding:6px 10px;font-family:monospace;font-size:10px;z-index:9999;display:none;word-break:break-all}
#assetStatus{position:fixed;top:10px;right:10px;background:rgba(0,0,0,.85);padding:8px 12px;border-radius:6px;font-size:11px;color:#8ec96f;z-index:45;pointer-events:none;display:none;max-width:260px;line-height:1.5;border:1px solid #8ec96f;white-space:pre-line}
#assetStatus.err{color:#ffb0b0;border-color:#7a3a3a}
#assetStatus.warn{color:#ffd54a;border-color:#8a7a3a}
@media (max-width:700px) and (orientation:portrait){
  .tc-dpad-up{bottom:220px;left:80px;width:65px;height:65px}
  .tc-dpad-down{bottom:80px;left:80px;width:65px;height:65px}
  .tc-dpad-left{bottom:150px;left:15px;width:65px;height:65px}
  .tc-dpad-right{bottom:150px;left:145px;width:65px;height:65px}
  .tc-atk{bottom:120px;right:25px;width:90px;height:90px}
  .tc-item{bottom:230px;right:40px;width:65px;height:65px}
  .tc-sleep{bottom:120px;right:130px;width:65px;height:65px}
}
</style>
</head>
<body>
<div id="errorBar"></div>
<div id="assetStatus"></div>
<div id="canvasWrapper"><canvas id="gameCanvas" width="800" height="600"></canvas></div>
<div id="touchControls"></div>
<div id="hud"><b>Клик / тап</b> — идти к точке<br><b>WASD</b> / стрелки<br><b>Пробел</b> — атака<br><b>E</b> — предмет<br><b>Z</b> — сон<br><b>Esc</b> — пауза</div>

<div id="menuMain" class="screen">
  <h1>PIXEL FARM</h1>
  <button id="btnNew" class="primary">Новая игра</button>
  <button id="btnLoad">Загрузить игру</button>
  <button id="btnSettings">Настройки</button>
</div>
<div id="menuSettings" class="screen hidden">
  <h2>Настройки</h2>
  <div class="slider-row"><label>Музыка</label><input type="range" id="musicVol" min="0" max="100" value="40"><span class="val" id="musicVal">40%</span></div>
  <div class="slider-row"><label>Звуки</label><input type="range" id="sfxVol" min="0" max="100" value="70"><span class="val" id="sfxVal">70%</span></div>
  <div class="row"><button id="btnBackFromSettings" class="small">Назад</button></div>
</div>
<div id="menuSaves" class="screen hidden">
  <h2 id="savesTitle">Сохранения</h2>
  <div id="slotsContainer" style="display:flex;flex-direction:column;gap:10px;align-items:center;width:100%"></div>
  <div class="row"><button id="btnBackFromSaves" class="small">Назад</button></div>
</div>
<div id="menuPause" class="screen hidden">
  <h2>Пауза</h2>
  <button id="btnResume" class="primary">Продолжить</button>
  <button id="btnSavePause">Сохранить</button>
  <button id="btnSettingsPause">Настройки</button>
  <button id="btnToMain" class="danger">В главное меню</button>
</div>

<script>
(function(){
'use strict';
const $=id=>document.getElementById(id);
const errorBar=$('errorBar');
window.addEventListener('error',e=>{errorBar.style.display='block';
  errorBar.textContent='Error: '+(e.message||e.error);
  setTimeout(()=>errorBar.style.display='none',6000);});

// ============================================================
// ГЕНЕРАЦИЯ СПРАЙТОВ (fallback)
// ============================================================
const TILE_SIZE=32;
const C={hatTop:'#d4a04a',hatBrim:'#a87830',hatBand:'#6a3a1a',skin:'#f5c898',skinD:'#d4a878',
  hair:'#5a3a1a',eye:'#1a0d05',shirt:'#3a6ab0',shirtD:'#2a4a80',pants:'#6a4a2a',boot:'#2a1a0a',
  leafDark:'#2a5a1a',leafMid:'#3a7a2a',leafHi:'#5aa83a',trunk:'#5a3a1a',trunkD:'#3a2a0a',
  rock:'#7a7a80',rockHi:'#a0a0a8',rockLo:'#4a4a50',dirt:'#8a6a3a',dirtD:'#6a4a2a',dirtHi:'#a8804a',
  grass:'#4a8c3a',grassD:'#3a7028',grassHi:'#6ab04a',water:'#3a6ac0',waterHi:'#5a8ad0',
  waterD:'#2a4aa0',crop:'#5aa03a',cropD:'#3a7028',wood:'#8a5a30',woodD:'#5a3a1a'};
function rect(c,x,y,w,h,col){c.fillStyle=col;c.fillRect(x,y,w,h);}
function genChar(c,ox,oy,dir,frame,anim){
  if(anim==='sleep'){rect(c,ox+4,oy+18,24,8,C.shirt);rect(c,ox+4,oy+18,24,2,C.shirtD);
    rect(c,ox+2,oy+20,4,4,C.skin);rect(c,ox+1,oy+19,5,3,C.hatBrim);
    rect(c,ox+2,oy+18,3,2,C.hatTop);rect(c,ox+26,oy+22,4,2,C.boot);
    const zx=ox+22,zy=oy+8;rect(c,zx,zy,5,1,'#fff');rect(c,zx+4,zy,1,3,'#fff');
    rect(c,zx,zy+2,5,1,'#fff');if(frame===1){rect(c,zx+5,zy-4,4,1,'#a0d0ff');
      rect(c,zx+8,zy-4,1,3,'#a0d0ff');rect(c,zx+5,zy-2,4,1,'#a0d0ff');}return;}
  let legOff=0;if(anim==='walk'){const s=[0,1,0,-1];legOff=s[frame%4];}
  const isAtk=anim==='attack',ap=isAtk?frame:0;
  if(dir==='U'){rect(c,ox+7,oy+2,18,2,C.hatTop);rect(c,ox+5,oy+4,22,3,C.hatBrim);
    rect(c,ox+7,oy+7,18,2,C.hatTop);rect(c,ox+7,oy+9,18,1,C.hatBand);rect(c,ox+9,oy+10,14,7,C.hair);}
  else{rect(c,ox+7,oy+2,18,2,C.hatTop);rect(c,ox+5,oy+4,22,3,C.hatBrim);
    rect(c,ox+7,oy+7,18,2,C.hatTop);rect(c,ox+7,oy+9,18,1,C.hatBand);
    if(dir==='D'){rect(c,ox+9,oy+10,14,7,C.skin);rect(c,ox+11,oy+12,2,2,C.eye);
      rect(c,ox+19,oy+12,2,2,C.eye);rect(c,ox+14,oy+15,4,1,C.skinD);}
    else if(dir==='L'){rect(c,ox+9,oy+10,13,7,C.skin);rect(c,ox+10,oy+12,2,2,C.eye);rect(c,ox+9,oy+14,1,2,C.skinD);}
    else{rect(c,ox+10,oy+10,13,7,C.skin);rect(c,ox+20,oy+12,2,2,C.eye);rect(c,ox+22,oy+14,1,2,C.skinD);}}
  const by=oy+17;rect(c,ox+10,by,12,8,C.shirt);rect(c,ox+10,by+7,12,1,C.shirtD);
  if(dir==='L'){rect(c,ox+10,by+1,3,6,C.shirt);rect(c,ox+10,by+6,3,2,C.skin);
    if(isAtk&&ap>0&&ap<4){rect(c,ox+6,by+2,4,2,C.skin);rect(c,ox+2,by,4,4,C.wood);rect(c,ox+1,by-1,6,2,C.rockHi);}
    rect(c,ox+19,by+1,2,6,C.shirtD);}
  else if(dir==='R'){rect(c,ox+19,by+1,3,6,C.shirt);rect(c,ox+19,by+6,3,2,C.skin);
    if(isAtk&&ap>0&&ap<4){rect(c,ox+22,by+2,4,2,C.skin);rect(c,ox+26,by,4,4,C.wood);rect(c,ox+25,by-1,6,2,C.rockHi);}
    rect(c,ox+11,by+1,2,6,C.shirtD);}
  else{rect(c,ox+8,by+1,2,6,C.shirt);rect(c,ox+22,by+1,2,6,C.shirt);
    rect(c,ox+8,by+6,2,2,C.skin);rect(c,ox+22,by+6,2,2,C.skin);
    if(isAtk&&ap>0&&ap<4){rect(c,ox+22,by+4,8,3,C.skin);rect(c,ox+28,by+2,4,6,C.wood);rect(c,ox+28,by,4,3,C.rockHi);}}
  const ly=oy+25;
  if(dir==='L'||dir==='R'){rect(c,ox+11,ly+Math.max(0,legOff),4,5-Math.max(0,legOff),C.pants);
    rect(c,ox+17,ly+Math.max(0,-legOff),4,5-Math.max(0,-legOff),C.pants);
    rect(c,ox+10,ly+5+Math.max(0,legOff)-1,5,2,C.boot);rect(c,ox+16,ly+5+Math.max(0,-legOff)-1,5,2,C.boot);}
  else{rect(c,ox+11,ly,4,5,C.pants);rect(c,ox+17,ly+Math.max(0,legOff),4,5-Math.max(0,legOff),C.pants);
    rect(c,ox+11,ly+5,4,2,C.boot);rect(c,ox+17,ly+5+Math.max(0,legOff),4,2,C.boot);}
  if(anim==='useItem'&&frame>0&&frame<4){
    if(dir==='D'||dir==='U'){rect(c,ox+22,oy+20,6,6,'#4aa83a');rect(c,ox+24,oy+18,2,2,'#4aa83a');}
    else if(dir==='L'){rect(c,ox+2,oy+20,6,6,'#4aa83a');}
    else{rect(c,ox+24,oy+20,6,6,'#4aa83a');}}
}
function makeGenChar(){
  const cv=document.createElement('canvas');cv.width=288;cv.height=320;
  const c=cv.getContext('2d');c.imageSmoothingEnabled=false;
  const rows=[{y:0,frames:2,a:'idle',d:['D','D']},{y:32,frames:4,a:'walk',d:['D','D','D','D']},
    {y:64,frames:4,a:'walk',d:['U','U','U','U']},{y:96,frames:4,a:'walk',d:['L','L','L','L']},
    {y:128,frames:4,a:'walk',d:['R','R','R','R']},{y:160,frames:4,a:'attack',d:['D','D','D','D']},
    {y:192,frames:4,a:'death',d:['D','D','D','D']},{y:224,frames:2,a:'sleep',d:['D','D']},
    {y:256,frames:4,a:'useItem',d:['D','D','D','D']}];
  rows.forEach(r=>{for(let i=0;i<r.frames;i++){const ox=i*32,oy=r.y;
    if(r.a==='death'){if(i===0)genChar(c,ox,oy,'D',0,'idle');
      else if(i===1){rect(c,ox+8,oy+18,16,10,C.shirt);rect(c,ox+10,oy+12,12,6,C.skin);rect(c,ox+9,oy+9,14,4,C.hatBrim);}
      else if(i===2){rect(c,ox+4,oy+22,24,6,C.shirt);rect(c,ox+8,oy+18,10,5,C.skin);rect(c,ox+8,oy+15,12,4,C.hatBrim);}
      else{rect(c,ox+3,oy+20,26,6,C.shirt);rect(c,ox+3,oy+20,26,2,C.shirtD);
        rect(c,ox+1,oy+22,5,4,C.skin);rect(c,ox+1,oy+20,5,3,C.hatBrim);
        rect(c,ox+25,oy+23,5,3,C.boot);rect(c,ox+18,oy+17,8,2,'#a02020');}}
    else genChar(c,ox,oy,r.d[i],i,r.a);}});
  return cv;
}
function genGrass(c,x,y,v){rect(c,x,y,32,32,C.grass);
  if(v===0){rect(c,x+5,y+8,3,2,C.grassD);rect(c,x+18,y+12,4,2,C.grassD);rect(c,x+10,y+22,5,2,C.grassHi);rect(c,x+22,y+25,3,2,C.grassD);}
  else if(v===1){for(let i=0;i<12;i++){const gx=x+((i*7)%28)+2,gy=y+((i*11)%28)+2;rect(c,gx,gy,2,3,i%2?C.grassD:C.grassHi);}}
  else{rect(c,x+6,y+6,2,2,'#ffd54a');rect(c,x+22,y+14,2,2,'#ff8aa8');rect(c,x+12,y+22,2,2,'#fff');rect(c,x+26,y+26,2,2,'#ffd54a');}}
function genDirt(c,x,y){rect(c,x,y,32,32,C.dirt);rect(c,x,y,32,2,C.dirtD);rect(c,x+4,y+8,3,2,C.dirtD);rect(c,x+18,y+6,4,2,C.dirtHi);rect(c,x+10,y+16,3,3,C.dirtD);rect(c,x+22,y+20,2,3,C.dirtD);rect(c,x+6,y+24,4,2,C.dirtHi);}
function genTree(c,x,y){rect(c,x+13,y+18,6,14,C.trunk);rect(c,x+13,y+18,2,14,C.trunkD);rect(c,x+6,y+4,20,4,C.leafMid);rect(c,x+3,y+6,26,14,C.leafMid);rect(c,x+6,y+2,20,2,C.leafHi);rect(c,x+2,y+8,4,10,C.leafDark);rect(c,x+26,y+8,4,10,C.leafDark);rect(c,x+8,y+6,4,3,C.leafHi);rect(c,x+18,y+10,4,3,C.leafHi);rect(c,x+12,y+14,3,3,C.leafHi);}
function genTreeDark(c,x,y){rect(c,x+14,y+22,4,10,C.trunk);for(let i=0;i<3;i++){const tw=4+i*6;rect(c,x+16-tw,y+4+i*6,tw*2,4,C.leafDark);rect(c,x+16-tw,y+4+i*6,tw*2,1,C.leafMid);}rect(c,x+2,y+22,28,4,C.leafDark);rect(c,x+2,y+22,28,1,C.leafMid);}
function genRock(c,x,y,s){if(s){rect(c,x+10,y+14,12,12,C.rock);rect(c,x+12,y+12,8,4,C.rockHi);rect(c,x+10,y+24,12,3,C.rockLo);}else{rect(c,x+6,y+10,20,18,C.rock);rect(c,x+8,y+8,16,4,C.rockHi);rect(c,x+10,y+6,12,4,C.rockHi);rect(c,x+6,y+25,20,3,C.rockLo);rect(c,x+12,y+12,3,3,'#c0c0c8');}}
function genFence(c,x,y){rect(c,x,y,32,32,C.grass);rect(c,x+2,y+8,3,20,C.wood);rect(c,x+14,y+8,3,20,C.wood);rect(c,x+27,y+8,3,20,C.wood);rect(c,x+2,y+12,26,3,C.wood);rect(c,x+2,y+20,26,3,C.wood);rect(c,x+2,y+8,3,20,C.woodD);rect(c,x+14,y+8,3,20,C.woodD);}
function genBarrel(c,x,y){rect(c,x,y,32,32,C.grass);rect(c,x+8,y+8,16,20,C.wood);rect(c,x+8,y+12,16,2,C.woodD);rect(c,x+8,y+22,16,2,C.woodD);rect(c,x+10,y+10,3,16,'#a06a3a');}
function genCrop(c,x,y,stage){rect(c,x,y,32,32,C.dirt);rect(c,x,y,32,2,C.dirtD);rect(c,x+2,y+6,28,2,C.dirtD);rect(c,x+2,y+16,28,2,C.dirtD);rect(c,x+2,y+26,28,2,C.dirtD);for(let i=0;i<3;i++)for(let j=0;j<3;j++){const px=x+5+j*9,py=y+6+i*10;if(stage===0){rect(c,px,py-2,2,4,C.crop);rect(c,px-2,py-1,2,2,C.cropD);rect(c,px+2,py-1,2,2,C.cropD);}else{rect(c,px-1,py-6,4,8,C.crop);rect(c,px-4,py-4,3,3,C.cropD);rect(c,px+2,py-4,3,3,C.cropD);rect(c,px,py-8,2,3,C.cropD);}}}
function genWater(c,x,y,corner){rect(c,x,y,32,32,C.water);rect(c,x,y,32,2,C.waterD);rect(c,x+4,y+8,6,1,C.waterHi);rect(c,x+18,y+14,8,1,C.waterHi);rect(c,x+6,y+22,5,1,C.waterHi);if(corner===0){rect(c,x+20,y+6,7,4,C.crop);rect(c,x+22,y+7,3,2,C.cropD);rect(c,x+23,y+6,1,1,'#ff8aa8');}}
function makeGenTiles(){
  const cv=document.createElement('canvas');cv.width=256;cv.height=192;
  const c=cv.getContext('2d');c.imageSmoothingEnabled=false;
  const O=0,Y=0;
  genGrass(c,O+0*32,Y+0*32,0);genGrass(c,O+1*32,Y+0*32,1);genGrass(c,O+2*32,Y+0*32,0);genGrass(c,O+3*32,Y+0*32,1);
  genDirt(c,O+4*32,Y+0*32);genDirt(c,O+5*32,Y+0*32);genDirt(c,O+6*32,Y+0*32);genGrass(c,O+7*32,Y+0*32,2);
  genDirt(c,O+0*32,Y+1*32);genGrass(c,O+1*32,Y+1*32,0);genGrass(c,O+2*32,Y+1*32,0);genDirt(c,O+3*32,Y+1*32);
  genDirt(c,O+4*32,Y+1*32);genGrass(c,O+5*32,Y+1*32,0);genGrass(c,O+6*32,Y+1*32,0);genGrass(c,O+7*32,Y+1*32,2);
  genTree(c,O+0*32,Y+2*32);genTree(c,O+1*32,Y+2*32);genTreeDark(c,O+2*32,Y+2*32);genTree(c,O+3*32,Y+2*32);
