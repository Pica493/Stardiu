function detectGrid(img){
  const W=img.naturalWidth, H=img.naturalHeight;
  let cv;
  try {
    cv=document.createElement('canvas');cv.width=W;cv.height=H;
    const c=cv.getContext('2d',{willReadFrequently:true});
    c.drawImage(img,0,0);
    var data=c.getImageData(0,0,W,H).data;
  } catch(e){
    return null; // CORS или другая ошибка
  }
  function isColored(x,y){
    const i=(y*W+x)*4;
    const r=data[i],g=data[i+1],b=data[i+2],a=data[i+3];
    if(a<100)return false;
    const mx=Math.max(r,g,b),mn=Math.min(r,g,b);
    // Строгий порог — только яркие/насыщенные пиксели
    return (mx-mn)>50 && mx>90 && mn<215;
  }
  // Покрытие по строкам
  const rowCov=new Float32Array(H);
  for(let y=0;y<H;y++){
    let cnt=0;
    for(let x=0;x<W;x++) if(isColored(x,y)) cnt++;
    rowCov[y]=cnt/W;
  }
  // Ищем первую строку, где окно 30 подряд идёт с покрытием > 30%
  let topY=-1;
  const win=30;
  for(let y=0;y<H-win;y++){
    let sum=0;
    for(let j=0;j<win;j++) sum+=rowCov[y+j];
    if(sum/win>0.30){topY=y;break;}
  }
  if(topY<0)topY=0;
  // Покрытие по столбцам ниже topY
  const colCov=new Float32Array(W);
  const yLimit=Math.min(topY+120,H);
  for(let x=0;x<W;x++){
    let cnt=0;
    for(let y=topY;y<yLimit;y++) if(isColored(x,y)) cnt++;
    colCov[x]=cnt/(yLimit-topY);
  }
  let leftX=-1;
  for(let x=0;x<W-win;x++){
    let sum=0;
    for(let j=0;j<win;j++) sum+=colCov[x+j];
    if(sum/win>0.25){leftX=x;break;}
  }
  if(leftX<0)leftX=0;
  // Размер ячейки: ищем первую "щель" по Y и X
  let cellY=64;
  for(let y=topY+16;y<Math.min(topY+200,H);y++){
    if(rowCov[y]<0.08){
      for(let y2=y+2;y2<Math.min(y+40,H);y2++){
        if(rowCov[y2]>0.20){cellY=y2-topY;break;}
      }
      break;
    }
  }
  let cellX=64;
  for(let x=leftX+16;x<Math.min(leftX+200,W);x++){
    if(colCov[x]<0.08){
      for(let x2=x+2;x2<Math.min(x+40,W);x2++){
        if(colCov[x2]>0.20){cellX=x2-leftX;break;}
      }
      break;
    }
  }
  let cell=Math.round((cellX+cellY)/2);
  // Кратно 16
  cell=Math.round(cell/16)*16;
  if(cell<16)cell=32;
  if(cell>256)cell=64;
  return {ox:leftX,oy:topY,cell:cell};
}

