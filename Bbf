// ============================================================
// СТАРТ/ПАУЗА
// ============================================================
function startGame() {
    gameState = GameState.PLAYING;
    showScreen('none');
    Audio.init();
    Audio.resume();
    Audio.startMusic();
}

function pauseGame() {
    if (gameState !== GameState.PLAYING) return;
    gameState = GameState.PAUSED;
    showScreen('pause');
}

function resumeGame() {
    gameState = GameState.PLAYING;
    showScreen('none');
    Audio.resume();
}

// ============================================================
// УПРАВЛЕНИЕ
// ============================================================
window.addEventListener('keydown', (e) => {
    const k = e.key.toLowerCase();
    keys[k] = true;

    if ([' ', 'arrowup', 'arrowdown', 'arrowleft', 'arrowright'].includes(k)) e.preventDefault();

    if (k === 'escape') {
        if (gameState === GameState.PLAYING) pauseGame();
        else if (gameState === GameState.PAUSED) resumeGame();
        return;
    }

    if (gameState !== GameState.PLAYING) return;

    // Нельзя прерывать атаку/предмет/сон другими действиями
    if (player.state === 'attack' || player.state === 'useItem') return;

    if (k === ' ') {
        player.state = 'attack';
        player.frameIndex = 0;
        player.frameTimer = 0;
        Audio.play('attack');
    } else if (k === 'e') {
        player.state = 'useItem';
        player.frameIndex = 0;
        player.frameTimer = 0;
        Audio.play('item');
    } else if (k === 'z') {
        if (player.state !== 'sleep') {
            player.state = 'sleep';
            player.frameIndex = 0;
            player.frameTimer = 0;
            Audio.play('sleep');
        }
    }
});

window.addEventListener('keyup', (e) => {
    keys[e.key.toLowerCase()] = false;
});

// ============================================================
// ЛОГИКА
// ============================================================
function isSolidAt(px, py) {
    const col = Math.floor(px / TILE_SIZE);
    const row = Math.floor(py / TILE_SIZE);
    if (col < 0 || col >= MAP_COLS || row < 0 || row >= MAP_ROWS) return true;
    const tile = mapData[row][col];
    return SOLID_TILES.includes(tile);
}

function checkCollision(nextX, nextY) {
    const padX = 8;
    const padTop = 18;
    const padBottom = 4;
    const left = nextX + padX;
    const right = nextX + 32 - padX;
    const top = nextY + padTop;
    const bottom = nextY + 32 - padBottom;
    return isSolidAt(left, top) || isSolidAt(right, top) ||
           isSolidAt(left, bottom) || isSolidAt(right, bottom);
}

function update(dt) {
    if (gameState !== GameState.PLAYING) return;
    if (!assetsLoaded) return;

    // === СОСТОЯНИЕ: СОН ===
    if (player.state === 'sleep') {
        const moving = keys['w']||keys['a']||keys['s']||keys['d']||
                       keys['arrowup']||keys['arrowleft']||keys['arrowdown']||keys['arrowright'];
        if (moving) {
            player.state = 'idle';
            player.frameIndex = 0;
            player.frameTimer = 0;
        } else {
            player.frameTimer += dt;
            const cfg = animConfig.sleep;
            if (player.frameTimer > cfg.speed) {
                player.frameTimer = 0;
                player.frameIndex = (player.frameIndex + 1) % cfg.frames;
                // Храп
                if (player.frameIndex === 0) Audio.play('sleep');
            }
            return;
        }
    }

    // === СОСТОЯНИЕ: АТАКА / ПРЕДМЕТ ===
    if (player.state === 'attack' || player.state === 'useItem') {
        player.frameTimer += dt;
        const cfg = animConfig[player.state];
        if (player.frameTimer > cfg.speed) {
            player.frameTimer = 0;
            player.frameIndex++;
            if (player.frameIndex >= cfg.frames) {
                player.state = 'idle';
                player.frameIndex = 0;
                player.frameTimer = 0;
            }
        }
        return;
    }

    // === ДВИЖЕНИЕ ===
    player.vx = 0; player.vy = 0; player.isMoving = false;
    let dx = 0, dy = 0;
    if (keys['w'] || keys['arrowup'])    { dy = -1; player.direction = 'up'; }
    if (keys['s'] || keys['arrowdown'])  { dy =  1; player.direction = 'down'; }
    if (keys['a'] || keys['arrowleft'])  { dx = -1; player.direction = 'left'; }
    if (keys['d'] || keys['arrowright']) { dx =  1; player.direction = 'right'; }

    // Нормализация для диагоналей
    if (dx !== 0 && dy !== 0) { dx *= 0.7071; dy *= 0.7071; }

    if (dx !== 0 || dy !== 0) player.isMoving = true;

    player.vx = dx * player.speed;
    player.vy = dy * player.speed;

    if (player.vx !== 0) {
        const nx = player.x + player.vx;
        if (!checkCollision(nx, player.y)) player.x = nx;
    }
    if (player.vy !== 0) {
        const ny = player.y + player.vy;
        if (!checkCollision(player.x, ny)) player.y = ny;
    }

    // === АНИМАЦИЯ ===
    let animState = 'idle';
    if (player.isMoving) {
        animState = 'walk' + player.direction.charAt(0).toUpperCase() + player.direction.slice(1);
    }

    if (player.state !== animState) {
        player.state = animState;
        player.frameIndex = 0;
        player.frameTimer = 0;
        player.lastStepFrame = -1;
    }

    player.frameTimer += dt;
    const cfg = animConfig[player.state];
    if (player.frameTimer > cfg.speed) {
        player.frameTimer = 0;
        const prevIdx = player.frameIndex;
        if (cfg.loop) {
            player.frameIndex = (player.frameIndex + 1) % cfg.frames;
        } else {
            if (player.frameIndex < cfg.frames - 1) player.frameIndex++;
        }
        // Звук шага на определённых кадрах
        if (cfg.stepFrames && cfg.stepFrames.includes(player.frameIndex) &&
            player.frameIndex !== prevIdx && player.isMoving) {
            Audio.play('step');
        }
    }

    // === КАМЕРА ===
    camera.x = player.x - WIDTH / 2 + 16;
    camera.y = player.y - HEIGHT / 2 + 16;
    camera.x = Math.max(0, Math.min(camera.x, MAP_COLS * TILE_SIZE - WIDTH));
    camera.y = Math.max(0, Math.min(camera.y, MAP_ROWS * TILE_SIZE - HEIGHT));
}

// ============================================================
// ОТРИСОВКА
// ============================================================
function draw() {
    // Фон
    ctx.fillStyle = '#0a1a0a';
    ctx.fillRect(0, 0, WIDTH, HEIGHT);

    if (!assetsLoaded) {
        ctx.fillStyle = '#fff';
        ctx.font = '14px Arial';
        ctx.textAlign = 'center';
        ctx.fillText('Загрузка...', WIDTH/2, HEIGHT/2);
        ctx.textAlign = 'left';
        return;
    }

    ctx.save();
    ctx.translate(-Math.round(camera.x), -Math.round(camera.y));

    // === ТАЙЛЫ ===
    const startCol = Math.max(0, Math.floor(camera.x / TILE_SIZE));
    const endCol = Math.min(MAP_COLS - 1, Math.ceil((camera.x + WIDTH) / TILE_SIZE));
    const startRow = Math.max(0, Math.floor(camera.y / TILE_SIZE));
    const endRow = Math.min(MAP_ROWS - 1, Math.ceil((camera.y + HEIGHT) / TILE_SIZE));

    for (let row = startRow; row <= endRow; row++) {
        for (let col = startCol; col <= endCol; col++) {
            const idx = mapData[row][col];
            const tCol = idx % TILESET_COLS;
            const tRow = Math.floor(idx / TILESET_COLS);
            const sx = TILESET_X + tCol * TILE_SIZE;
            const sy = TILESET_Y + tRow * TILE_SIZE;
            ctx.drawImage(assets, sx, sy, TILE_SIZE, TILE_SIZE,
                          col * TILE_SIZE, row * TILE_SIZE, TILE_SIZE, TILE_SIZE);
        }
    }

    // === ИГРОК ===
    const cfg = animConfig[player.state] || animConfig.idle;
    const sx = player.frameIndex * TILE_SIZE;
    const sy = cfg.y;

    // Тень под игроком
    ctx.fillStyle = 'rgba(0,0,0,0.25)';
    ctx.beginPath();
    ctx.ellipse(player.x + 16, player.y + 30, 12, 4, 0, 0, Math.PI * 2);
    ctx.fill();

    ctx.drawImage(assets, sx, sy, TILE_SIZE, TILE_SIZE,
                  Math.round(player.x), Math.round(player.y), TILE_SIZE, TILE_SIZE);

    ctx.restore();

    // === HUD ===
    if (gameState === GameState.PLAYING) {
        ctx.fillStyle = 'rgba(0,0,0,0.55)';
        ctx.fillRect(8, HEIGHT - 26, 160, 20);
        ctx.fillStyle = '#8ec96f';
        ctx.font = '11px monospace';
        ctx.textAlign = 'left';
        ctx.fillText(`State: ${player.state}`, 14, HEIGHT - 12);
    }
}

// ============================================================
// ИГРОВОЙ ЦИКЛ
// ============================================================
let lastTime = performance.now();

function gameLoop(now) {
    let dt = now - lastTime;
    lastTime = now;
    if (dt > 100) dt = 100;

    update(dt);
    draw();

    requestAnimationFrame(gameLoop);
}

// ============================================================
// ИНИЦИАЛИЗАЦИЯ
// ============================================================
showScreen('main');
requestAnimationFrame(gameLoop);

// Пауза при потере фокуса
window.addEventListener('blur', () => {
    if (gameState === GameState.PLAYING) pauseGame();
});
</script>
